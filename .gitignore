bin/
obj/
dist/
artifacts/
# worktrack loop state is per-clone; the workspace binding and the workflow
# template manifest are project-owned and committed so every host drains alike
.worktrack/*
!.worktrack/mcp.json
!.worktrack/templates.json
.dartai/
*.user
*.suo
.vs/
**/TestResults/
*.dmp

# Transient scheduler lock — runtime state, not source (was tracked by mistake).
.claude/scheduled_tasks.lock

# Binary-module DLLs staged transiently into the script module dir by
# test-local.ps1 / CI Pester staging — never source. The module ships
# .psd1/.psm1/.ps1xml only; the cmdlets DLL lives in PsBash.Cmdlets.
src/PsBash.Module/*.dll

# Cygwin/MSYS crash dumps — git-bash occasionally drops these in the repo root
*.stackdump
