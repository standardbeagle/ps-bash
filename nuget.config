<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The Strata local feed (../strata/local-feed) is intentionally NOT a global
         source: a configured-but-missing local source is a hard NU1301 restore
         error, which would break CI (runners lack the feed). Instead it is added
         per-project via RestoreAdditionalProjectSources only when UseStrata=true
         (see src/PsBash.Cmdlets/PsBash.Cmdlets.csproj). Until Strata ships to
         nuget.org, build with the feed present (auto) or -p:UseStrata=true. -->
  </packageSources>
</configuration>
