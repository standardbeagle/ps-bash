<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Strata sibling repo, packed locally via ../strata/scripts/pack-local.sh.
         Pre-publish: Strata.* are consumed from this folder until they ship to nuget.org. -->
    <add key="strata-local" value="../strata/local-feed" />
  </packageSources>
</configuration>
