<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableExperimentalBashEval Condition="'$(EnableExperimentalBashEval)' == ''">false</EnableExperimentalBashEval>

    <!-- Mirror PsBash.Cmdlets: build the Format-Styled tests only when the Strata
         local feed is present (auto) or -p:UseStrata=true. CI lacks the feed, so
         the cmdlet is not built there and its tests would fail at runtime. -->
    <StrataLocalFeed Condition="'$(StrataLocalFeed)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\strata\local-feed'))</StrataLocalFeed>
    <UseStrata Condition="'$(UseStrata)' == '' and Exists('$(StrataLocalFeed)')">true</UseStrata>
    <UseStrata Condition="'$(UseStrata)' == ''">false</UseStrata>
    <!-- This project pulls Strata.* transitively via the Cmdlets ProjectReference
         when UseStrata=true, so it needs the feed as a restore source too. -->
    <RestoreAdditionalProjectSources Condition="'$(UseStrata)' == 'true'">$(RestoreAdditionalProjectSources);$(StrataLocalFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableExperimentalBashEval)' != 'true'">
    <Compile Remove="InvokeBashEvalCommandTests.cs" />
    <Compile Remove="ModuleScopeBindingTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseStrata)' != 'true'">
    <Compile Remove="FormatStyledCommandTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Management.Automation" Version="7.4.*" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageReference Include="coverlet.collector" Version="6.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PsBash.Cmdlets\PsBash.Cmdlets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PsBash.Cmdlets\PsBash.Cmdlets.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PsBash.Module\PsBash.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PsBash.Module\PsBash.psm1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PsBash.Module\PsBash.Format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
