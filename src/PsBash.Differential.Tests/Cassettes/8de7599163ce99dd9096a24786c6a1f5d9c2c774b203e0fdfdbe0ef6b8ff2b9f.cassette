==== SCRIPT ====
cd "$(mktemp -d)"
echo one 1>&2; echo two 1<&2; echo two2 2<&1
echo hi 9>&1; echo hi 99>&1
echo hi 9>f.txt; test -f f.txt && echo "created [$(cat f.txt)]"
echo hi 9>&-
w9() { echo "via9 $1" >&9; }
w9 a 9>&1; w9 b 9>g.txt; echo "g=[$(cat g.txt)]"; w9 c 9>&2
printf 'L1\nL2\n' > in.txt; read -u 7 line 7<in.txt; echo "line=$line st=$?"
