==== SCRIPT ====
t() { printf '%s rc=%s m=%s\n' "$1" "$2" "$(printf '%q,' "${BASH_REMATCH[@]}")"; }
v() { local n=$1 s=$2 re=$3; [[ $s =~ $re ]]; t "$n" $?; }
shopt -s nocasematch
[[ AB =~ ^ab$ ]]; t e36 $?
v C01 D '\d'
v C03 A '[a-z]'
v C04 a '[A-Z]'
v C05 A '[[:lower:]]'
v C07 É 'é'
v C08 a '[^A]'
v C09 'ǅ' 'ǆ'
v C10 'ß' 'SS'
v C12 'ς' 'Σ'
v C14 'é' '[É]'
[[ xAB =~ a(b) ]]; t C15 $?
