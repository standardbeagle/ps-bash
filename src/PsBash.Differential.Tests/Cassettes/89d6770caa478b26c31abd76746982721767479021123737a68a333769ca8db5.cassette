==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
for i in 1; do exec >log; echo e$i >&2; done 2>&1
exec >&5 5>&-
echo log:
cat log
==== STDOUT ====
e1
log:

