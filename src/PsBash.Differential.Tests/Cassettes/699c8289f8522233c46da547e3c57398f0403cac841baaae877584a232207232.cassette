==== SCRIPT ====
declare -A m; k=K
printf -v "m['q']" x1; printf -v 'm["$k"]' x2; printf -v 'm[${k}2]' x3; printf -v 'm[a b]' x4; printf -v 'm[$(echo c)]' x5
for e in "${!m[@]}"; do echo "$e=${m[$e]}"; done | sort
a=(0 1 2); i=1
printf -v 'a[$i]' y1; printf -v 'a[i+1]' y2; printf -v 'a[-1]' y3; printf -v 'a[5]' y4; printf -v 'a[$(echo 0)]' y5
declare -p a
printf -v 'm[$u]' z 2>/dev/null; echo st=$?; printf -v 'a[-9]' z 2>/dev/null; echo st=$?
x=5; printf -v 'x[2]' z; declare -p x; s=3; (( s[2] = 7 )); declare -p s
f() { printf -v 'nw[1]' q; (( na[1] = 4 )); }; f; declare -p nw na
unset 'm[$k]' "m['q']"; for e in "${!m[@]}"; do echo "$e"; done | sort
