==== SCRIPT ====
shopt -s extglob
for p in 'a:!(a)*' 'ab:!(a)b' 'b:!(a)b' 'ab:@(a)!(c)' 'ac:@(a)!(c)' 'foo.log.txt:!(*.log)' 'foo.log:!(*.log)' 'zoo:!(f*|b*)' 'foo:!(f*|b*)'; do s=${p%%:*}; pat=${p#*:}; eval "[[ \$s == $pat ]]" && echo "1 $p" || echo "0 $p"; done
