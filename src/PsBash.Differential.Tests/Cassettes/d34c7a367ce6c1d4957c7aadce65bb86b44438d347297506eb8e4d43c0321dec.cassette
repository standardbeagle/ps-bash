==== SCRIPT ====
set -- -a; while getopts 'ab:' o; do :; done; echo OPTIND=$OPTIND; set -- -c -d; while getopts 'cd' o; do echo $o; done; echo OPTIND=$OPTIND
==== STDOUT ====
OPTIND=2
d
OPTIND=3

