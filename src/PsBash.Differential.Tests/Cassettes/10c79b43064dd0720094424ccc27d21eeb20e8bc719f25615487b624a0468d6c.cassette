==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 3>f
{ exec 3>&-; } & wait
echo p >&3
exec 3>&-
cat f
==== STDOUT ====
p

