==== SCRIPT ====
function rev { builtin eval "
  set -- \"\${$1[@]}\"; $1=()
  local e$1 i$1=\$#
  for e$1; do $1[--i$1]=\"\$e$1\"; done"; }
a=(99 4 5 6)
rev a
echo "${a[@]}"
