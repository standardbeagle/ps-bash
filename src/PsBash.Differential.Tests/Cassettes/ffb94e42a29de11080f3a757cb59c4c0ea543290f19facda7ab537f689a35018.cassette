==== SCRIPT ====
d=$(mktemp -d); cd "$d" || exit; mkdir sub; for op in "$d/nope" ./nope nope sub/../nope "$d/sub/nope"; do cat "$op"; head -n1 "$op"; wc -l "$op"; grep x "$op"; sort "$op"; tail -n1 "$op"; done 2>&1 | sed "s|$d|D|g"; cd / && rm -rf "$d"
