PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 303
stdout-length: 28
stderr-length: 0
==== SCRIPT ====
d=$(mktemp -d)
cd "$d"
cat > "$d/o.sh" <<'PSB_EOF'
perl -e 'print(($ENV{PSB_M} // "unset"), "\n")' 2>&1
x=$(perl -e 'print(($ENV{PSB_M} // "unset"), "\n")' 2>&1); echo "sub: $x"
perl -e 'print(($ENV{PSB_M} // "unset"), "\n")' 2>&1 | cat
PSB_EOF
( export PSB_M=v )
. "$d/o.sh"
echo rc=$?
cd /
rm -rf "$d"
==== STDOUT ====
unset
sub: unset
unset
rc=0

