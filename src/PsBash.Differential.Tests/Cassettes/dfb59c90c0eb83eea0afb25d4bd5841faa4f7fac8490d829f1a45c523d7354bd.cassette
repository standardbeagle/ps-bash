==== SCRIPT ====
declare k=ab pwn; echo "k [$k] st:$?"; typeset nn=5 zz; echo "nn [$nn]"
readonly r=r1
typeset +r r=r2 2>/dev/null; echo "t st:$? [$r]"
declare r=r3 2>/dev/null; echo "d st:$? [$r]"; echo same-line
