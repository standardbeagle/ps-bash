PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 588
stdout-length: 28
stderr-length: 0
==== SCRIPT ====
d=$(mktemp -d)
cd "$d"
cat > "$d/o.sh" <<'PSB_EOF'
pwsh -NoProfile -NonInteractive -Command '[Console]::Out.Write($(if ($null -eq $env:PSB_M) { "unset" } else { $env:PSB_M }) + "`n")' 2>&1
x=$(pwsh -NoProfile -NonInteractive -Command '[Console]::Out.Write($(if ($null -eq $env:PSB_M) { "unset" } else { $env:PSB_M }) + "`n")' 2>&1); echo "sub: $x"
pwsh -NoProfile -NonInteractive -Command '[Console]::Out.Write($(if ($null -eq $env:PSB_M) { "unset" } else { $env:PSB_M }) + "`n")' 2>&1 | cat
PSB_EOF
export PSB_M=v
bash -c 'export -n PSB_M; . "$1"' _ "$d/o.sh"
echo rc=$?
cd /
rm -rf "$d"
==== STDOUT ====
unset
sub: unset
unset
rc=0

