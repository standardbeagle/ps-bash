==== SCRIPT ====
cd "$(mktemp -d)" || exit 99
{ for i in 1 2; do if { continue; echo in; } | cat; then echo yes; else echo no; fi; echo "loop $i"; done
echo "end $?"
} 2>e.txt; sed 's/^.*line [0-9]*: //' e.txt
