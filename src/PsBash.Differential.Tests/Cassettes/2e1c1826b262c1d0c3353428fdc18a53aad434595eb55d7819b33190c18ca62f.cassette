==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 3>&1
e=$(echo out 2>&1 1>&3)
echo "e=[$e]"
