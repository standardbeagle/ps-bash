==== SCRIPT ====
while true; do false; break; done; echo brk=$?
i=0; while [ $i -lt 2 ]; do i=$((i+1)); false; continue; done; echo cont=$?
i=0; while (( i < 2 )); do i=$((i+1)); false; done; echo body-last=$?
i=0; while (( i < 2 )); do i=$((i+1)); done; echo body-ok=$?
for ((i=0; i<2; i++)); do false; done; echo cfor=$?
false; for ((i=0; i<0; i++)); do :; done; echo cfor-empty=$?
false; while false; do :; done; echo wempty=$?
false; until true; do :; done; echo uempty=$?
for x in a b; do if [ $x = b ]; then break; fi; false; done; echo forin-brk=$?
