==== SCRIPT ====
printf 'ab\0cd\0' | head -c 3 | od -c; echo "a ${PIPESTATUS[*]}"
printf 'ab\0cd\0' | head -c 3 | od -c | cat; echo "b ${PIPESTATUS[*]}"
printenv -0 | head -c 3 | wc -c; echo "c ${PIPESTATUS[*]:1}"
printenv -0 | head -c 3 | od -c | wc -l; echo "d ${PIPESTATUS[*]:1}"
seq 5 | head -n 2 | wc -l; echo "e ${PIPESTATUS[*]:1}"
seq 5 | head -n 2 | sort -r | uniq -c; echo "f ${PIPESTATUS[*]:1}"
x=$(seq 9 | head -n 2 | tr '\n' ,); echo "g $x"

