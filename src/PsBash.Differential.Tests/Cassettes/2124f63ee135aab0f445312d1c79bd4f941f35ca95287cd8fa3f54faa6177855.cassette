==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
f() { echo e >&2; }
f |& f |& tr e E
f 2>&1 | { f 2>&1; } | tr e E
echo after
==== STDOUT ====
E
E
after

