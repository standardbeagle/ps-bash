PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 354
stdout-length: 41
stderr-length: 0
==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=abc
case $s in !(b)) c=Y;; *) c=n;; esac
if [[ $s == !(b) ]]; then e=Y; else e=n; fi
if [[ $s != !(b) ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#!(b)}" "${s##!(b)}" "${s%!(b)}" "${s%%!(b)}" "${s/!(b)/X}" "${s//!(b)/X}" "${s/#!(b)/X}" "${s/%!(b)/X}" "${s^^!(b)}" "${s,,!(b)}" "${s^!(b)}"
echo

==== STDOUT ====
Y|Y|n|abc|''|abc|''|X|X|X|X|AbC|abc|Abc|

==== STDERR ====

