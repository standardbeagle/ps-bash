==== SCRIPT ====
cd "$(mktemp -d)" || exit 99
{ for i in 1 2; do printf '%s\n' 'break; echo in' > s.sh; ( source ./s.sh; echo in2 ); echo "after $?"; echo "loop $i"; done
echo "end $?"
} 2>e.txt; sed 's/^.*line [0-9]*: //' e.txt
