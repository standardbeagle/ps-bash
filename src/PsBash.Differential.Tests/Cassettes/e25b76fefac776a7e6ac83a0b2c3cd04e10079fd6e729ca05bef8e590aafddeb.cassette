==== SCRIPT ====
t() { printf '%s rc=%s m=%s\n' "$1" "$2" "$(printf '%q,' "${BASH_REMATCH[@]}")"; }
v() { local n=$1 s=$2 re=$3; [[ $s =~ $re ]]; t "$n" $?; }
[[ $'a\nb' =~ a.b ]]; t e09 $?
[[ $'a\n' =~ a$ ]]; t e10 $?
[[ $'x\na' =~ ^a ]]; t e11 $?
v V64 $'\n' '^[^a]$'
v V65 'a^b' 'a^b'
v V66 'b' 'a|^b'
v V67 'xay' 'x$y'
v V71 'ab' '(^a)(b$)'
