==== SCRIPT ====
cd "$(mktemp -d)" || exit
for c in "grep -c ''" "grep -n ''" 'sed =' 'cat -n' 'cat -A' 'cat' 'nl -ba' 'cut -c1' 'tr a b' 'tr a b | wc -l' 'rev' 'tac' 'sort' 'uniq -c' 'head -n 9' 'tail -n 9' 'tail -n +1' 'shuf | sort' 'column -t' "rg -c ''" "rg -n ''" 'fold' 'expand' 'unexpand' 'paste -' 'comm - /dev/null' 'awk {print\ NR\ \$0}' 'wc -l'; do
  for src in "printf 'a\n\n'" "printf 'a\n\n\n'" "printf '\n\n'" "printf 'a\n\nb\n\n'" "printf 'a\nb'" "printf ''" "{ printf x; printf 'a\n\n'; }"; do
    eval "$src | $c" > o 2>&1; echo "## $c <- $src: $(od -An -c o | tr -s ' ' | tr -d '\n')"
  done
done
cd / 
