==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
touch ab; d=.; p $d/"+(a)"*; p $d/"*"b; p $d/'[a]'*
shopt -s extglob
p $d/"+(a)"* $d/+(a)*
==== STDOUT ====
1:<./+(a)*>
1:<./*b>
1:<./[a]*>
2:<./+(a)*><./ab>

