==== SCRIPT ====
sf=$(mktemp)
cat > "$sf" <<'EOF'
echo child
trap 'echo usr1' USR1
sh -c "kill -9 $$"
echo notreached
EOF
{ bash "$sf"; echo "status=$?"; } 2>/dev/null
rm -f "$sf"

