cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
( { echo o; echo e >&2; } 3>&1 1>&2 2>&3 | sed 's/^/P:/' ) 2>e35
echo e35:
cat e35
