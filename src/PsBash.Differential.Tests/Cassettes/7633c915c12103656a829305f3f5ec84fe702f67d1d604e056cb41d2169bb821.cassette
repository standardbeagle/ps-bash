==== SCRIPT ====
export PATH=/usr/bin
eval $(printf 'export FNM_MULTISHELL_PATH="/tmp/fnm_msh"\nexport PATH="/tmp/fnm_msh":"$PATH"\n')
echo $FNM_MULTISHELL_PATH
case "$PATH" in /tmp/fnm_msh?/usr/bin) echo prepended ;; *) echo "PATH=$PATH" ;; esac
==== STDOUT ====
/tmp/fnm_msh
prepended

