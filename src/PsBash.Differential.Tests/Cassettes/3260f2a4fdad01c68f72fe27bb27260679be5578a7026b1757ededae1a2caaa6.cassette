[[ '€' =~ [[:punct:]] ]]; t F28 $?
[[ 'é' =~ [^a] ]]; t F30 $?
[[ 'aé' =~ ^a[^x]$ ]]; t F32 $?
re='\w'; [[ 'é' =~ $re ]]; t F34 $?
re='\bé'; [[ 'aé' =~ $re ]]; t F35 $?
