y='p=1 q=2'; builtin declare $y; echo "[$p] [$q]"
f() { builtin local s=$x; echo "[$s]"; command local t="$x"; echo "[$t]"; }; f
builtin declare h=*.zzz; echo "[$h]"; n='a;echo pwn'; builtin declare k=$n 2>/dev/null; echo "[$k]"
