==== SCRIPT ====
g() { read r; echo "r=$r"; head -1; cat; }
cd "$(mktemp -d)"
echo old > out
printf '1\n2\n3\n4\n5\n' | until false; do read r; echo "r=$r"; head -1; cat; break; done >> out
cat out
==== STDOUT ====
old
r=1
2

