==== SCRIPT ====
gs() { q=5; }
ga() { (( q = 6 )); }
gr() { read q <<< 7; }
gp() { printf -v q '%s' 8; }
gl() { let q=9; }
gx() { q+=x; }
gu() { unset q; }
show() { echo "$1 [$q] $((q+0)) ${q:-empty}"; }
for ((q = 0; q < 1; q++)); do for w in gs ga gr gp gl gx; do q=0; $w; show $w; done; q=0; done; echo "end [$q]"
