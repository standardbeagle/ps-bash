==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 3>&1
{ echo y 2>/dev/null 3>&5 >&3; echo "s=$?"; } 2>E
exec 3>&-
err E
==== STDOUT ====
s=1

