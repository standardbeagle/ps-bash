==== SCRIPT ====
p() { printf '<%s>' "$@"; printf ' #%s\n' "$#"; }
x='a b'; unset u
p ${x/ /{1,2\}}; echo after
p ${x/ /\}} "${x/ /{\}}" ${x:-{a,b\}}
p ${u:-{a,b}} ${u:-{a}b} ${u:-{} ${u:-${u:-{a}}}
p "${u:-$(echo })}" "${u:-`echo }`}" ${u:-$'\'}'}
p "${x:-'}'}" "${u:-'}'}" "${u:-"{}"}" "${u:-\{\}}"
y=${u:-a:{b}:c}; p "$y"; a=(1); p ${a[0]:-{z}}
p $(echo ${u:-)}); p "$(echo "${u:-)}")"
p {a,${x/ /\}}} {a,${u:-{b}} {a,$(echo },)} x{a,${u:-b,c}}y {a,${x/ /,}}
cat <<EOF
${u:-{h}} ${x/ /\}} ${u:-{a,b\}}
EOF
echo end
