d=$(mktemp -d) && cd "$d" && mkdir sub && printf 'x' > a && printf 'yyyyyyyyyy' > b && printf 'zzz' > c && touch -d '3 hours ago' a && touch -d '2 hours ago' b && touch -d '1 hour ago' c; ls --a 2>/dev/null; echo rc=$?; cd /; rm -rf "$d"
