==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
{ x=$(echo y 2>/dev/null >&5); echo "s=$? x=$x"; } 2>E
err E
