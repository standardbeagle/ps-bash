==== SCRIPT ====
t(){ "$@"; echo "$1=$?"; }
h1(){ { return 6; } 3>x; echo no; }; t h1
h2(){ { return 6; } {fd}>x; echo no; }; t h2
h3(){ eval 'return 6' <<< x; echo no; }; t h3
h4(){ builtin eval 'return 6' 2>/dev/null; echo no; }; t h4
h5(){ eval 'return 6' 9>x; echo no; }; t h5
h7(){ while true; do { return 6; } 2>x; done; echo no; }; t h7
h8(){ g(){ { return 2; } 2>x; echo gno; }; { g; echo "g=$?"; } 2>x; echo after; }; t h8
h9(){ { if true; then return 6; fi; } 2>x | cat; echo "pipe=$?"; }; t h9
h10(){ if { return 6; } 2>x; then echo then; fi; echo no; }; t h10
h11(){ { return 6; } 2>x && echo and; echo no; }; t h11
h12(){ ! { return 6; } 2>x; echo no; }; t h12
h13(){ x=$( { return 6; } 2>/dev/null; echo sub ); echo "x=$x"; }; t h13
h14(){ ( { return 7; } 2>/dev/null; echo sub ); echo "st=$?"; }; t h14
c='{ return 5; } 2>/dev/null'; h15(){ eval "$c"; echo no; }; t h15
h18(){ { true; } 2>x; echo yes; }; t h18

