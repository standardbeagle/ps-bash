==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
for f in aaaa bbbb cccc dddd eeee ffff; do printf '' > $f; done
} >/dev/null 2>&1
echo '== stdout'
{ :
ls -C -w 16 | cat -A; ls -C -w 17 | cat -A
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
