g() { local -p nosuchv; echo "rc=$?"; }
g
type nosuchcmd
echo "rc=$?"
alias nosuchal
echo "rc=$?"
EOF
bash s.sh >out 2>err; cat err; echo ---; cat out
cd /; rm -rf "$W"
