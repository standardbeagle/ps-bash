==== SCRIPT ====
a=(x y z); i=1
r1='a[i]'; r2='a[i+1]'; r3='a[-1]'; r4='a[5]'; r5='a[ 0 ]'
echo "1=${!r1} 2=${!r2} 3=${!r3} 4=${!r4} 5=${!r5}"
PWD=1; r6='a[~+]'
( echo "6=${!r6}" ) 2>/dev/null
echo st=$?
