==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 4>t
echo y 2>&4 3>&5
echo "s=$?"
exec 4>&-
echo t:
err t
