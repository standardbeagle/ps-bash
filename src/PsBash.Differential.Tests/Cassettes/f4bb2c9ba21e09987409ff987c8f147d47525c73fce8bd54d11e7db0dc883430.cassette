==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
if true; then exec >log1; fi
echo after-if
exec >&5 5>&-
cat log1
==== STDOUT ====
after-if

