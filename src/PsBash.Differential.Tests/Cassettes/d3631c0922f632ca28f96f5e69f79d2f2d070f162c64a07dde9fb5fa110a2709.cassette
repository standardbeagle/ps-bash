==== SCRIPT ====
d=/tmp; f=psb_rt_$$
echo x > $d/$f; echo y >> "$d/$f"
cat /tmp/$f
[ -e $d/$f ] && echo test-e
[[ -f "$d/$f" ]] && echo dbl-f
while read -r l; do echo "read $l"; done < $d/$f
rm $d/$f
[ -e /tmp/$f ] || echo gone
==== STDOUT ====
x
y
test-e
dbl-f
read x
read y
gone

