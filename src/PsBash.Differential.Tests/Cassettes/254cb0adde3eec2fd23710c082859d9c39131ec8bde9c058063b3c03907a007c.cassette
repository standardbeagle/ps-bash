==== SCRIPT ====
cd "$(mktemp -d)"
printf 'read b; echo "b=$b"\n' > r.sh
printf 'libfn() { read b; echo "lib=$b"; }\n' > lib.sh
printf '1\n2\n3\n4\n5\n' > in
. ./lib.sh
rd() { read b; echo "b=$b"; }
outer() { rd; }
c='read b; echo "b=$b"'
cmd=rd
g() { read -n 1 ch; echo "ch=$ch"; read rest; echo "rest=$rest"; }
while read a; do read -n 1 ch; echo "ch=$ch"; read rest; echo "rest=$rest"; echo "a=$a"; done < in
echo "rc=$?"
