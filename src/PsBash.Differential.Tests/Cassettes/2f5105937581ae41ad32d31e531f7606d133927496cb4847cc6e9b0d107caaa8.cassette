v=abc; printf '%s|' "${v^b}" "${v^^ab}" "${v^^[ab]}" "${v^}" "${v^^}"; v=ABC; printf '%s|' "${v,b}" "${v,,BC}" "${v,,[BC]}" "${v,}"; echo
