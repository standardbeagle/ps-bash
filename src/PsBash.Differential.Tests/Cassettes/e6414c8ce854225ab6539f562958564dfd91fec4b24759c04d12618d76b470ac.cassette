==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
{ { exec >log; echo e >&2; } 2>&1; echo e2 >&2; } 2>&1
exec >&5 5>&-
echo log:
cat log
==== STDOUT ====
e
e2
log:

