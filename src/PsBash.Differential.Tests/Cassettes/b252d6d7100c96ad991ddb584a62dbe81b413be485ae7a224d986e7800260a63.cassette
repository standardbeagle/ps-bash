PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 375
stdout-length: 157
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 'p/q'
printf '%s\n' 'R' > 'p/q/r'
mkdir -p 'out'
} >/dev/null 2>&1
echo '== stdout'
{ :
cp -v --parents p/q/r out
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
p -> out/p
p/q -> out/p/q
'p/q/r' -> 'out/p/q/r'
== exit 0
== fs
D .
D ./out
D ./out/p
D ./out/p/q
F ./out/p/q/r Ugo=
D ./p
D ./p/q
F ./p/q/r Ugo=

==== STDERR ====

