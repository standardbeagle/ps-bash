==== SCRIPT ====
x=outer; ( x=inner; export X2=1 ); echo "$x [${X2:-unset}]"; ( cd / ); [ "$PWD" != / ] && echo cd-local; ( shopt -s nullglob ); for f in /nonexist-zz/*; do echo "glob $f"; done; ( trap 'echo T' USR1 ); trap -p USR1; echo trap-local
