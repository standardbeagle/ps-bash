PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 822
stdout-length: 7922
stderr-length: 0
==== SCRIPT ====
cd "$(mktemp -d)" || exit
printf 'R1\nR2' > rf; printf 'R1\nR2\n' > rt
for s in "-n '\$='" "'\$='" "-n '='" "'\$a X'" "'\$i X'" "'\$c X'" "'1a X'" "-n '\$l'" "'\$l'" "-n '1p'" "-n '\$p'" "'\$p'" "-n 'p;p'" "'\$P'" "'N;P;D'" "'\$!N;P'" "'s/b/B/p'" "-n 's/a/A/p'" "'1h;\$!d;x'" "'1h;\$!d;G'" "'\$!d;H;x'" "'\$!d;g'" "'1!G;h;\$!d'" "-n 'x;\$p'" "'\$r rf'" "'\$r rt'" "'1r rf'" "'R rf'" "'\$R rf'" "'\$q'" "'1q'" "'2q'" "'\$d'" "'n;d'" "'\$!n'" "'y/ab/AB/'" "-n '\$F'" "-n '\$p;\$q'" "'\$p;\$q'" "'\$=;\$q'" "'\$Q'" "'\$p;\$Q'" "-e '\$r rf' -e '\$q'" "'\$!N;P;D'" "-e '1{N;a X' -e '};P;D'" "-e '1{N;i X' -e '};P;D'"; do
  for src in "printf 'a\nb'" "printf 'a\nb\n'" "printf a" "{ printf 'a\n'; printf b; }"; do
    eval "$src | sed $s" > o 2>&1; echo "## $s <- $src: $(od -An -c o | tr -s ' ' | tr -d '\n')"
  done
done
cd / 
