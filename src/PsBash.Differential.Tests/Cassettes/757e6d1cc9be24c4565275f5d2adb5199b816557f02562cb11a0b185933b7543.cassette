cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
p $(printf 'a\nb')x; IFS=; p $x$x; p $(echo a b)$x; unset IFS; p $x""$x
