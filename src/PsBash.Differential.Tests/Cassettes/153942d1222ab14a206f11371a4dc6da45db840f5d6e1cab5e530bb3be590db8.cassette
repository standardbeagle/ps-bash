==== SCRIPT ====
shopt -s globstar
d=$(mktemp -d); cd "$d"; mkdir -p c/sub; touch c/sub/leaf.md
echo {**/*.*,} | sed 's/ *$//'
echo {foo,bar}.c {*.md,nope}
cd /; rm -rf "$d"
