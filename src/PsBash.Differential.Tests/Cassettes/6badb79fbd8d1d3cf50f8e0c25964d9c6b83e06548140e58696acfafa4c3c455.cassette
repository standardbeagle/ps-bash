==== SCRIPT ====
gs() { q=5; }
ga() { (( q = 6 )); }
gr() { read q <<< 7; }
gp() { printf -v q '%s' 8; }
gl() { let q=9; }
gx() { q+=x; }
gu() { unset q; }
show() { echo "$1 [$q] $((q+0)) ${q:-empty}"; }
for q in a; do q=b; show body; read q <<< c; show read; printf -v q d; show printf; (( q = 4 )); show arith; done
