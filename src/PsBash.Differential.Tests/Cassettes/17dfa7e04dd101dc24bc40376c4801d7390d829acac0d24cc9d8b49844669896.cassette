==== SCRIPT ====
cd "$(mktemp -d)"
set -o pipefail
{ echo a; i=0; while [ ! -f seen ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done; if [ -f seen ]; then echo b-after-loop-read-a; else echo b-loop-never-saw-a; fi; } | while read -r l; do echo "got $l"; touch seen; done
echo "rc=$? ps=${PIPESTATUS[*]}"
==== STDOUT ====
got a
got b-after-loop-read-a
rc=0 ps=0 0

