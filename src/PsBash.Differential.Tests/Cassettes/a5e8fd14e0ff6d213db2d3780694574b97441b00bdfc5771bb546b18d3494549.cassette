b=([010]=x [2]=y); declare -p b
c=([08]=x [1]=y); declare -p c; echo after-c
a=(a b c d e); i=1; echo "${a[@]:$i:2}"; set -- p q r s; echo "${@:$i:1}" "${@:$#}"
i=010; echo "${a[@]:$i}|"; i=' 1 '; echo "${a[@]:$i:1}"; j='1+1'; echo "${a[@]:$j:1}"; i=-2; echo "${a[@]:$i}"
( set -u; echo "${a[@]:$zz}"; echo not-here ); echo "st=$?"
s=abcdef; x=${s:08}; echo "[$x]"; echo same-line
if [[ ${s:08} == a ]]; then echo y; fi; echo same
f(){ echo ${s:08}; echo in-f; }; f; echo after
y=$(echo ${s:08}; echo inner); echo "[$y]"
( echo ${s:08}; echo inner ); echo outer
echo end
EOF
bash s.sh >out 2>err; cat err; echo ---; cat out
cd /; rm -rf "$W"
