==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 3>f
{ echo o; echo e >&2; } 2>&1 >&3 | sed 's/^/P:/'
exec 3>&-
echo f:
cat f
==== STDOUT ====
P:e
f:
o

