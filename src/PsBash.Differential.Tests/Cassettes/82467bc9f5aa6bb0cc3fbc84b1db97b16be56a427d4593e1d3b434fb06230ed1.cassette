PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 188
stdout-length: 5
stderr-length: 0
==== SCRIPT ====
d=$(mktemp -d); cd "$d"; cat > s.sh <<'PSBASH_EOF'
shopt -s expand_aliases
alias e_='echo "'
var=x
e_ '${var}"'
echo after
PSBASH_EOF
bash s.sh 2>/dev/null; echo "rc=$?"; cd /; rm -rf "$d"
==== STDOUT ====
rc=2

