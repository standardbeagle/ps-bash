==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=xx
case $s in [[:foo:]]x) c=Y;; *) c=n;; esac
if [[ $s == [[:foo:]]x ]]; then e=Y; else e=n; fi
if [[ $s != [[:foo:]]x ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#[[:foo:]]x}" "${s##[[:foo:]]x}" "${s%[[:foo:]]x}" "${s%%[[:foo:]]x}" "${s/[[:foo:]]x/X}" "${s//[[:foo:]]x/X}" "${s/#[[:foo:]]x/X}" "${s/%[[:foo:]]x/X}" "${s^^[[:foo:]]x}" "${s,,[[:foo:]]x}" "${s^[[:foo:]]x}"
echo

