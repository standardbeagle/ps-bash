==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
x='a,b c'; IFS=: printf '1<%s>\n' $(IFS=,; printf '[%s]' $x); IFS=: printf '2<%s>\n' "$(IFS=,; printf '[%s]' $x)"; IFS=: printf '3<%s>\n' $(printf '[%s]' $x)
