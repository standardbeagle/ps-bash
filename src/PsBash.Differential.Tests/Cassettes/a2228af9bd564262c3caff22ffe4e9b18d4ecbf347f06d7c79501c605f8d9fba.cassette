==== SCRIPT ====
mkdir -p srcpd/sh srcpd/dir/hi.sh srcpd/loc
echo 'echo from-path' > srcpd/sh/hi.sh
echo 'echo from-cwd' > srcpd/loc/hi.sh
PATH="srcpd/sh:$PATH" . hi.sh; echo "a st:$?"
PATH="srcpd/dir:srcpd/sh:$PATH" . hi.sh; echo "b st:$?"
cd srcpd/loc; . hi.sh; PATH="../sh:$PATH"; . hi.sh; shopt -u sourcepath; . hi.sh
{ . nope_zq.sh; } 2>/dev/null; echo "c st:$?"
