==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
cd "$(mktemp -d)" || exit
echo $(compgen -W 'abc abd xyz a.c' -X 'a?c'); echo $(compgen -W 'abc abd xyz a.c' -X '!@(a*)'); echo $(compgen -W 'abc abd xyz' -X '[!a]*')
==== STDOUT ====
abd xyz
abc abd a.c
abc abd

