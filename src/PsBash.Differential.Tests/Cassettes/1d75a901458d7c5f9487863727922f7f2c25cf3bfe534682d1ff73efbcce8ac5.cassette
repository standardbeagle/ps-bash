PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 622
stdout-length: 646
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
cat > s.sh <<'EOF'
PS1='n=\# h=\!'
echo "${PS1@P}"
echo a; echo "${PS1@P}"
if true; then
  echo "if ${PS1@P}"
fi
x=$(echo "${PS1@P}"); echo "sub $x"
eval 'echo "ev ${PS1@P}"'; echo "after ${PS1@P}"
set -o history
history -c
echo "${PS1@P}"
for i in 1 2
do echo "$i ${PS1@P}"
done
echo "_${PS1@P}"
history
EOF
} >/dev/null 2>&1
echo '== stdout'
{ :
bash s.sh; echo st=$?
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
