PSBASH-ORACLE-CASSETTE v1
bash-version: wsl
exit-code: 0
script-length: 422
stdout-length: 386
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
echo s > s; mkdir -p ip
} >/dev/null 2>&1
echo '== stdout'
{ :
install -v s s2; install -v -d id1/id2 id3; install -v -D s dd/ee/ff; install -v s id3; install -v -t ip s
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
