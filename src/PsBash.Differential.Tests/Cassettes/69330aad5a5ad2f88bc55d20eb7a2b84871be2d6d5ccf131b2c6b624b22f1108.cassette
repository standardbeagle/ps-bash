==== SCRIPT ====
cd "$(mktemp -d)" || exit; printf '#!/bin/sh\nexit 5\n' > p.sh; printf '#!/bin/sh\necho x\nexit 5\n' > q.sh; chmod +x p.sh q.sh; set -o pipefail; ./q.sh | grep --bogus 2>/dev/null | cat > out; echo "14 pf rc=$?"; echo x | grep --bogus 2>/dev/null | cat > out; echo "15 pf rc=$?"; echo x | grep x | ./p.sh > out; echo "16 pf rc=$?"
