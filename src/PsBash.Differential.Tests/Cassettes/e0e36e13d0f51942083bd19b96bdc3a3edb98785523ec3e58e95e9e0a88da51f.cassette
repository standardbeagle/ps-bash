==== SCRIPT ====
for c in 'sed s/a/b/' 'head -1' 'head -c 3' 'grep -c .' 'cat' 'tail -1' 'sort'; do printf '%d' x 2>&1 >/dev/null | $c >/dev/null; echo "$c s=$?"; done
