==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'a 1
b 2
a 3
' > 'data'
} >/dev/null 2>&1
echo '== stdout'
{ :
awk '{ print > "na" }' data
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
== exit 0
== fs
D .
F ./data YSAxCmIgMgphIDMKCg==
F ./na YSAxCmIgMgphIDMKCg==

