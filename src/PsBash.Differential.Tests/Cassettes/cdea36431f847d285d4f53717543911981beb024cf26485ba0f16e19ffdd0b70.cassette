y='p=1 q=2'; declare $y; echo "d [$p] [$q]"
y='p2=1 q2=2'; export $y; echo "e [$p2] [$q2]"; printenv q2
y='p4=1 q4=2'; typeset $y; echo "t [$p4] [$q4]"
y='u=1'; declare -x w $y; echo "[$u]"; printenv u
x='a b'; declare z=$x; echo "z [$z]"
