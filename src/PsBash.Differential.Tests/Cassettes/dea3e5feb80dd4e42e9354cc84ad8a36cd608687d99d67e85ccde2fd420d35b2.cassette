==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
n='a;echo pwn'; m='$(echo pwn)'; q='"x y"'; p $n$m; p $q$q; p `echo '$x'`$x; set -- "$m" '`echo pwn`'; p "$@"$m
