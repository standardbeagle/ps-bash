p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
a=($x$x ~/$x $e$e "$x"$x); p "${a[@]}"
