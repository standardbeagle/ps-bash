t=$(mktemp -d); cd "$t" || exit 1; echo x >a >b; echo y >p >q >r; echo old > s; echo new >>s >u; d=.; echo z >$d/m >"$d/n"; ls /nonexistent_psb 2>f1 2>f2; for f in a b p q r s u m n; do printf '%s=[%s]\n' $f "$(cat $f)"; done; wc -c < f1; cat f2; cd /; rm -rf "$t"
