d=$(mktemp -d); cd "$d"; cat > s.sh <<'PSBASH_EOF'
a=(1 2 3)
echo one; echo ${a[]}; echo same
echo next=$?
eval 'echo z ${(m)foo} z'; echo st=$?
echo -{z..A}-; echo same2
echo range=$?
x=${q:?gone}
echo notreached
PSBASH_EOF
bash s.sh 2>/dev/null; echo "rc=$?"; cd /; rm -rf "$d"
