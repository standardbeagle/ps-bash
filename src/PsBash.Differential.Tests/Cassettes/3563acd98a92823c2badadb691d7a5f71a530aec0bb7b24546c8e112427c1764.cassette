==== SCRIPT ====
d=$(mktemp -d); cd "$d"; cat > s.sh <<'PSBASH_EOF'
echo a ${x!y} b; echo same
echo next=$?
f() { echo f1; echo ${x!y}; echo f2; }
g() { f; echo g2; }
g; echo same2
for i in 1 2; do echo $i; echo ${x!y}; done; echo same3
echo end=$?
PSBASH_EOF
bash s.sh 2>/dev/null; echo "rc=$?"; cd /; rm -rf "$d"
