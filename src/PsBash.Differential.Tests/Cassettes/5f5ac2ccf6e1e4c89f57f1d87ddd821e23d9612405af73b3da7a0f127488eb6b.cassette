echo next4'; echo "st=$?"; } 2>&1
{ bash -c '( exit 1 2; echo in5 ); echo "after5 $?"
echo next5'; echo "st=$?"; } 2>&1
{ bash -c 'x=$(shift 1 2; echo in6); echo "after6 [$x] $?"
echo next6'; echo "st=$?"; } 2>&1
