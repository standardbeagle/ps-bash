PSBASH-ORACLE-CASSETTE v1
bash-version: wsl
exit-code: 0
script-length: 240
stdout-length: 37
stderr-length: 0
==== SCRIPT ====
trap 'echo URG' URG
kill -URG $$
trap - URG
kill -URG $$; echo "self $?"
kill -WINCH $$; kill -s CHLD $$; echo "st $?"
{ sleep 0.2; echo child; } & kill -URG $!; echo "k $?"; wait $!; echo "w $?"
kill -URG 999999 2>/dev/null; echo "none $?"
==== STDOUT ====
URG
self 0
st 0
k 0
child
w 0
none 1

==== STDERR ====

