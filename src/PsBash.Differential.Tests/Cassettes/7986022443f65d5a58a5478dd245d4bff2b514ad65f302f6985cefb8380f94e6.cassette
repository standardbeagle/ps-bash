PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 381
stdout-length: 96
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 's'
printf '%s\n' 'F' > 's/f'
mkdir -p 't'
printf '%s\n' 'G' > 't/g'
} >/dev/null 2>&1
echo '== stdout'
{ :
cp -rvT s t
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
's/f' -> 't/f'
== exit 0
== fs
D .
D ./s
F ./s/f Rgo=
D ./t
F ./t/f Rgo=
F ./t/g Rwo=

