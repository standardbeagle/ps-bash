==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=ẞx
case $s in [[:upper:]]) c=Y;; *) c=n;; esac
if [[ $s == [[:upper:]] ]]; then e=Y; else e=n; fi
if [[ $s != [[:upper:]] ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#[[:upper:]]}" "${s##[[:upper:]]}" "${s%[[:upper:]]}" "${s%%[[:upper:]]}" "${s/[[:upper:]]/X}" "${s//[[:upper:]]/X}" "${s/#[[:upper:]]/X}" "${s/%[[:upper:]]/X}" "${s^^[[:upper:]]}" "${s,,[[:upper:]]}" "${s^[[:upper:]]}"
echo

