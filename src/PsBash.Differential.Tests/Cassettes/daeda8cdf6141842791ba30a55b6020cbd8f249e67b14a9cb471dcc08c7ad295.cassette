==== SCRIPT ====
cd "$(mktemp -d)" || exit; { kill -USR2 $BASHPID; echo after; } & wait $! 2>err; echo "USR2 $?"; grep -o -e 'User defined signal [12]' -e Hangup -e Killed -e Terminated -e Interrupt -e Quit -e 'Broken pipe' err; grep -c -i -e exception -e EndInvoke err; echo still-running
