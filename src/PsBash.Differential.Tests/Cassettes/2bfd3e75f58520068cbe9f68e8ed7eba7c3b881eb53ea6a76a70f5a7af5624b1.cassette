==== SCRIPT ====
g() { read r; echo "r=$r"; head -1; cat; }
cd "$(mktemp -d)"
printf '1\n2\n3\n4\n5\n' | while read l; do echo "l=$l"; read r; echo "r=$r"; head -1; cat; done > out
echo "rc=$?"; cat out
