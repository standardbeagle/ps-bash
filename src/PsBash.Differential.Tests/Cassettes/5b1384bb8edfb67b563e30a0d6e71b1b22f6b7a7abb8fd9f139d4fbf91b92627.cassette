==== SCRIPT ====
[[ $ =~ "$" ]] && echo 'yes $'
[[ $ == "$" ]] && echo eq1
[[ "$" == $ ]] && echo eq2
[[ a$ == "a$" ]] && echo eq3
[ $ = $ ] && echo eq4
[[ $ != x ]] && echo ne
x='$'; [[ $x == $ ]] && echo eq5
y=5; [[ $y -eq 5 ]] && echo num
