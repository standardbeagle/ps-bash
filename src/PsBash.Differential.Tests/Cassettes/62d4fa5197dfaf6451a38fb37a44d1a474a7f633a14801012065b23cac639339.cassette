==== SCRIPT ====
PATH=/nonexistent-psbash-no-programs
for c in gci sls iex icm r h ni ri del erase ren select measure group foreach gcm saps; do
  type -t "$c" >/dev/null 2>&1; t=$?; "$c" x >/dev/null 2>&1; echo "$c type=$t run=$?"
done
iex 'echo injected' 2>/dev/null; echo "iex=$?"
