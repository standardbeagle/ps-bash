==== SCRIPT ====
sf=$(mktemp)
cat > "$sf" <<'EOF'
echo child
trap 'echo t' USR2
trap - USR2
sh -c "kill -USR2 $$"
echo notreached
EOF
{ bash "$sf"; echo "status=$?"; } 2>/dev/null
rm -f "$sf"

