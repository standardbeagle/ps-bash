==== SCRIPT ====
shopt -s extglob
d=$(mktemp -d); cd "$d"; touch foo.py bar.py spam.py
echo ${undef:-@(foo|bar).py}; echo ${undef:-*.py}; echo @(foo|'spam').py
echo @(__nope__*|'*'|'?'|'|'|"[x]"|\*); set -o noglob; echo @(*|'*'); set +o noglob
cd /; rm -rf "$d"
==== STDOUT ====
bar.py foo.py
bar.py foo.py spam.py
foo.py spam.py
@(__nope__*|*|?|||[x]|*)
@(*|*)

