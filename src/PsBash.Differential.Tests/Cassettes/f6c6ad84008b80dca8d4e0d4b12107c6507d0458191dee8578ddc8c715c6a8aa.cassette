==== SCRIPT ====
cd "$(mktemp -d)" || exit; exec 5<&0; echo "dup rc=$?"; printf 'a\nb\nc\n' | { exec 6<&0; read -u 6 l; echo "l=$l"; cat <&6; }; echo q | { exec 7</dev/stdin; echo "dev rc=$?"; read -u 7 m; echo "m=$m"; }; printf 'x\ny\n' | { exec 8<&0; exec 9<&8; read -u 9 n; echo "n=$n"; read o; echo "o=$o"; }; exec 5<&-; echo "close rc=$?"; read -u 5 z 2>/dev/null; echo "closed read rc=$?"; printf 'F1\nF2\n' > f; exec 6<f; echo up | cat <&6; echo "rc=$?"; exec 6<f; printf 's1\ns2\n' | { cat <&6; read l; echo "l=$l"; }
