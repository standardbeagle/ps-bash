==== SCRIPT ====
for j in 1 2 3; do echo "job $j $((j * 10))" & done | sort; wait
for ((k = 0; k < 2; k++)); do echo "k $k $((k + 5))" & done | sort; wait
printf '7\n8\n' | while read r; do echo "r $r $((r * 2))" & done | sort; wait
