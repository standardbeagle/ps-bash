==== SCRIPT ====
W="$(mktemp -d)"; cd "$W"
{
arr=(); ar2=(1 "2 3"); sp="p q"
f() { $unset echo infn "$@"; }
set -x
$unset -c 'echo 2'
echo a $unset b
echo "" x "$unset"
echo "$@" y
echo "${arr[@]}" z
echo $sp
echo "${ar2[@]}" ${ar2[@]}
f
v=$unset
w="$sp"
: ${unset}
echo $unset"" q
set +x
} 2>&1
cd /; rm -rf "$W"
