PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 381
stdout-length: 133
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 's'
printf '%s\n' 'F' > 's/f'
} >/dev/null 2>&1
echo '== stdout'
{ :
cp -rL s t1; cp -rP s t2; cp -rH s t3; cp -rd s t4
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
== exit 0
== fs
D .
D ./s
F ./s/f Rgo=
D ./t1
F ./t1/f Rgo=
D ./t2
F ./t2/f Rgo=
D ./t3
F ./t3/f Rgo=
D ./t4
F ./t4/f Rgo=

