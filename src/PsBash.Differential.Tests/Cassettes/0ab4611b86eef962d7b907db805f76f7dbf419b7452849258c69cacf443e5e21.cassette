==== SCRIPT ====
h() { :; }; v=1; h=2; unset v -f h; echo "st=$? v=[${v-unset}] h=[${h-unset}]"; type -t h
w=1; unset -- -v w; echo "st=$? w=[${w-unset}]"
x=1; unset -n -- x; echo "st=$? x=[${x-unset}]"
k() { :; }; k=1; unset -- -f k; echo "st=$? k=[${k-unset}]"; type -t k
==== STDOUT ====
