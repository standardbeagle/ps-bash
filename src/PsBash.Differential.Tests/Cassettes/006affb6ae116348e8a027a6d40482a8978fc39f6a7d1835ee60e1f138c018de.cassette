PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 326
stdout-length: 39
stderr-length: 0
==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=abc
case $s in *c) c=Y;; *) c=n;; esac
if [[ $s == *c ]]; then e=Y; else e=n; fi
if [[ $s != *c ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#*c}" "${s##*c}" "${s%*c}" "${s%%*c}" "${s/*c/X}" "${s//*c/X}" "${s/#*c/X}" "${s/%*c/X}" "${s^^*c}" "${s,,*c}" "${s^*c}"
echo

==== STDOUT ====
Y|Y|n|''|''|ab|''|X|X|X|X|abC|abc|abc|

==== STDERR ====

