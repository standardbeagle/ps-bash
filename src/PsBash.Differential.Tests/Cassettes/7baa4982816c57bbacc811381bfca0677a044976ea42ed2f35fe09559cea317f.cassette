==== SCRIPT ====
f() { eval "$1"; echo "end $1"; }
f return; echo "a st:$?"
f 'return 3'; echo "b st:$?"
printf 'echo in-lib; return 5; echo no\n' > evretlib.sh
h() { eval "$1"; echo "after-source $?"; }; h '. ./evretlib.sh'; echo "d st:$?"
k() { eval 'eval "$1"'; echo k-no; }; k 'return 6'; echo "k st:$?"
n() { for i in 1 2; do eval "$1"; echo "n$i"; done; echo n-end; }; n 'return 8'; echo "n st:$?"
f 'echo x'; echo "e st:$?"
