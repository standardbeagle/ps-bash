==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
fx() { exec >log1; echo in-fn; }
fx
echo after-fn
exec >&5 5>&-
echo back
cat log1
==== STDOUT ====
back
in-fn
after-fn

