PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 250
stdout-length: 21
stderr-length: 0
==== SCRIPT ====
cd "$(mktemp -d)" || exit
cat > t.sh <<'EOF'
{
( Error=(e); Error+=(f); echo "1 ${Error[*]}" )
( Matches=(m n); echo "2 ${Matches[*]}" )
} 2>&1
echo x | while read l; do input+=("$l"); echo "3 ${#input[@]}"; done
EOF
{ bash t.sh; echo "rc=$?"; } 2>&1
==== STDOUT ====
1 e f
2 m n
3 1
rc=0

==== STDERR ====

