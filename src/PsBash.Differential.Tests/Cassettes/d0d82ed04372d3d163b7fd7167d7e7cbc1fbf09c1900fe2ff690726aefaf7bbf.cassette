==== SCRIPT ====
sf=$(mktemp)
cat > "$sf" <<'EOF'
echo child
echo a
sh -c "kill -USR1 $$"
echo notreached
EOF
{ bash "$sf"; echo "status=$?"; } 2>/dev/null
rm -f "$sf"

