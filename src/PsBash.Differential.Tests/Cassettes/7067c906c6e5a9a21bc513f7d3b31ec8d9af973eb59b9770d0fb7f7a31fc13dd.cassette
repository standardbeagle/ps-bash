==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p d1/sub d1/only1 d2/sub d2/only2 d1/both d2/both; echo same > d1/same; echo same > d2/same; echo one > d1/diff; echo two > d2/diff; echo x > d1/onlyfile1; echo y > d2/onlyfile2; echo s1 > d1/sub/f; echo s2 > d2/sub/f; echo c > d1/Zed; echo c > d2/zed; mkdir d1/dirvsfile; echo f > d2/dirvsfile
} >/dev/null 2>&1
echo '== stdout'
{ :
diff -N d1 d2 > __out 2>/dev/null; echo "rc=$?"; sed 's/\t.*//' __out; rm -f __out
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
