==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 's/x'
printf '%s\n' 'new1' > 's/x/f1'
mkdir -p 's/x'
printf '%s\n' 'new2' > 's/x/f2'
mkdir -p 't/s/x'
printf '%s\n' 'old1' > 't/s/x/f1'
} >/dev/null 2>&1
echo '== stdout'
{ :
cp -rn s t
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
