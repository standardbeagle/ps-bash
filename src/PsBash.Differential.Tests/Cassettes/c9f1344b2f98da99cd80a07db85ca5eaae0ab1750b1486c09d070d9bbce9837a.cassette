==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
x=$({ exec >log; echo o; echo e >&2; } 2>&1)
echo "x=$x"
echo log:
cat log
