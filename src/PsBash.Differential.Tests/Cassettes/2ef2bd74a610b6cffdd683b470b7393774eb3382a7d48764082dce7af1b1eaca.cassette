__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p a
} >/dev/null 2>&1
echo '== stdout'
{ :
mkdir -pv a/b/c; mkdir -pv ./a/x//y/; mkdir -pv a/b/c/d
}
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
