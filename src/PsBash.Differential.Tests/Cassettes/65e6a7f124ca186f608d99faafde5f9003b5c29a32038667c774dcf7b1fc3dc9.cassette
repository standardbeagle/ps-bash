==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' '1' > 'x'
} >/dev/null 2>&1
echo '== stdout'
{ :
for f in $(echo 'q*'); do echo "<$f>"; done
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
<q*>
== exit 0
== fs
D .
F ./x MQo=

