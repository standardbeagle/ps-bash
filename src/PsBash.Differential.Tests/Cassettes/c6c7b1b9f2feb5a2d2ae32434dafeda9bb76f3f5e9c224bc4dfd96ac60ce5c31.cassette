==== SCRIPT ====
d=$(mktemp -d); cd "$d"; cat > s.sh <<'PSBASH_EOF'
unset r; echo ${!r}; echo same
echo next=$?
b='bad name'; echo ${!b}
echo st=$?
echo "a$(echo ${!r})b"; echo same4
x=$(echo ${x!y}); echo "x=[$x] $?"
PSBASH_EOF
bash -c "$(cat s.sh)" 2>/dev/null; echo "rc=$?"; cd /; rm -rf "$d"
==== STDOUT ====
next=1
st=1
ab
same4
x=[] 1
rc=0

