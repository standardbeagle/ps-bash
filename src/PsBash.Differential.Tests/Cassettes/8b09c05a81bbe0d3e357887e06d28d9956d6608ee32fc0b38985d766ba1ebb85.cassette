PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 431
stdout-length: 68
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'o' > 'old'
printf '%s\n' 'm' > 'mid'
} >/dev/null 2>&1
echo '== stdout'
{ :
touch -t 200101010000 old mid; touch --time=mtime -t 202401021530 mid; ls -t; echo r=$?
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
mid
old
r=0
== exit 0
== fs
D .
F ./mid bQo=
F ./old bwo=

