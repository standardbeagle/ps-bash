==== SCRIPT ====
cd "$(mktemp -d)" || exit; nohup ls /nosuch > out.txt 2>&1; echo "rc=$?"; sed 's/^.*ls: /ls: /' out.txt; nohup sh -c 'exit 3' > o2.txt; echo "rc=$?"; nohup sh -c 'echo hi; echo err >&2' 2>/dev/null | cat; echo "rc=$?"; nohup true | cat; echo "rc=$?"; nohup nosuchcmd > o3.txt 2>&1; echo "rc=$?"; sed 's/^.*nohup: /nohup: /' o3.txt; x=$(nohup echo captured 2>/dev/null); echo "x=$x rc=$?"; printf 'a\nb\n' | nohup cat; nohup sh -c 'exit 5' 2>/dev/null; echo "rc=$?"; nohup nosuchcmd 2>&1 | sed 's/^.*nohup: /nohup: /'; echo "nohup.out exists: $(test -e nohup.out && echo yes || echo no)"
