PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 341
stdout-length: 49
stderr-length: 0
==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s='*x'
case $s in "x") c=Y;; *) c=n;; esac
if [[ $s == "x" ]]; then e=Y; else e=n; fi
if [[ $s != "x" ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#"x"}" "${s##"x"}" "${s%"x"}" "${s%%"x"}" "${s/"x"/X}" "${s//"x"/X}" "${s/#"x"/X}" "${s/%"x"/X}" "${s^^"x"}" "${s,,"x"}" "${s^"x"}"
echo

==== STDOUT ====
n|n|Y|\*x|\*x|\*|\*|\*X|\*X|\*x|\*X|\*X|\*x|\*x|

==== STDERR ====

