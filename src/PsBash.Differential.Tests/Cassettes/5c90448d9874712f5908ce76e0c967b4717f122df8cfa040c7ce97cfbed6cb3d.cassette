==== SCRIPT ====
W="$(mktemp -d)"; cd "$W"; mkdir d; long=$(printf '%0300d' 0); ./nosuch 2>e; echo "missing $? $(grep -c 'No such file or directory' e)"; ./d 2>e; echo "dir $? $(grep -c 'Is a directory' e)"; ./$long 2>e; echo "long $? $(grep -c 'File name too long' e)"; ./x/$long/y 2>e; echo "past-missing $? $(grep -c 'No such file or directory' e)"; nosuch_cmd_q 2>e; echo "bare $? $(grep -c 'command not found' e)"; cd /; rm -rf "$W"
