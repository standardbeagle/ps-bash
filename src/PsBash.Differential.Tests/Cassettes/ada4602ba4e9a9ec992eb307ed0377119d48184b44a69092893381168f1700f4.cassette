bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 524
stdout-length: 7989
stderr-length: 0
==== SCRIPT ====
d=$(mktemp -d); cd "$d" || exit; d=$(pwd); mkdir sub; touch f
for c in 'readlink' 'readlink -f' 'readlink -e' 'readlink -m' 'readlink -fv' 'readlink -ev' 'readlink -mv' 'readlink -v' 'realpath' 'realpath -e' 'realpath -m' 'realpath -q' 'realpath -s' 'realpath -L' 'realpath -sm'; do
  echo "## $c"
  for op in f sub sub/ f/ nosuch sub/nosuch sub/nosuch/ nosuch/x sub/../f ./sub/./f sub/nosuch/../f f/x f/.. "$d/sub/../f" '' 'a b' "it's"; do $c "$op"; echo "  rc=$? [$op]"; done
done 2>&1 | sed "s|$d|D|g"
cd / && rm -rf "$d"
