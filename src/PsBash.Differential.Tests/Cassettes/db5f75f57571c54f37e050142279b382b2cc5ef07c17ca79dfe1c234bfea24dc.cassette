==== SCRIPT ====
cd "$(mktemp -d)" && printf 'a\nb\nc\n' > f && printf 'x\ny\n' > g && awk 'BEGIN{ f = "f"; getline a < f; getline b < f; close(f); getline c < f; print a b c }'
