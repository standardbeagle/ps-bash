==== SCRIPT ====
W="$(mktemp -d)"; cd "$W"
cat > s.sh <<'EOF'
a=(a b c d e f g h i j k l)
k=010; echo "${a[$k]}" "${a[k]}" "${a[010]}" "${a[$k]:-none}" "${a[k]:-none}"
declare -A m=([010]=x); echo "${m[010]}" "${m[$k]}"
b=(a b c d e f g h i j k l); i=-010; unset 'b[i]'; echo "${b[@]}"
c=(a b c d e f g h i j k l); unset 'c[010]'; echo "${c[@]}"
d=(); d[010]=x; echo "${!d[@]}"
ref='a[010]'; echo "${!ref}"
declare -i n=010; echo "$n"
h=ff; echo $((16#$h)) $((16#$h + 1)); (( v = 16#$h )); echo "$v"
echo $((16#FF)) $((16#Ff)) $((36#Z)) $((20#J)) $((64#Z))
i=08; echo "${a[$i]}"
echo "rc=$?"
echo end
EOF
bash s.sh >out 2>err; cat err; echo ---; cat out
cd /; rm -rf "$W"
