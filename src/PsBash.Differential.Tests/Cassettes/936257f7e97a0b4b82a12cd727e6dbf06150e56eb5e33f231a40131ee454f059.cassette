==== SCRIPT ====
cd "$(mktemp -d)"; shuf -r -n 2 -e a; shuf -n 2 -o out -e x y; sort out; shuf -e a -i 1-2; echo rc=$?; shuf a b; echo rc=$?; shuf -i 5-1; echo rc=$?; shuf -i 3-3; shuf -i 2-1; echo rc=$?; shuf -n x -e a; echo rc=$?; shuf -r -e a | head -3; shuf -n 1 -n 3 -e a b c d | wc -l; shuf -r -n 2 < /dev/null; echo rc=$?; shuf -i 1-3 extra; echo rc=$?
