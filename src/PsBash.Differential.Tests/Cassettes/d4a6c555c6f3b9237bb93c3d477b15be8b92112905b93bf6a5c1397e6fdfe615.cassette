p() { printf '[%s]' "$@"; echo; }; IFS=x; v=; p ${v:-AxBxC}x; p ${v:-"AxBxC"}x; p "${v:-AxBxC}"x
IFS=' '; f='a b.c'; p ${f%.c}.o; p q${f/b/c d}; p ${f:+x y}z
