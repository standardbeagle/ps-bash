bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 678
stdout-length: 67
stderr-length: 0
==== SCRIPT ====
printf 'return 9\necho fileafter\n' > rc
printf 'break\necho fileafter\n' > rcb
t(){ "$@"; echo "$1=$?"; }
g(){ return 3; }; c1(){ g 2>/dev/null; echo "c1in=$?"; }; t c1
s1(){ source ./rc 2>/dev/null; echo "s1in=$?"; }; t s1
s2(){ . ./rc >x; echo "s2in=$?"; }; t s2
for i in 1 2 3; do { break; } 2>/dev/null; echo no; done; echo "L1=$i"
for i in 1 2; do { continue; } 2>x; echo no; done; echo "L2=$i"
for i in 1 2 3; do if true; then break; fi >x; echo no; done; echo "L3=$i"
for i in 1 2 3; do while true; do break 2; done 2>x; echo no; done; echo "L5=$i"
for i in 1 2 3; do source ./rcb 2>/dev/null; echo "after$i"; done; echo "L6=$i"
{ return 6; } 2>/dev/null; echo "top=$?"

