W="$(mktemp -d)"; cd "$W"
{
echo start
command nosuch_cmd
n=nosuch_var; $n
true && nosuch_and
echo p | nosuch_pipe
for i in 1 2; do
  nosuch_loop
done
} 2>&1
cd /; rm -rf "$W"
