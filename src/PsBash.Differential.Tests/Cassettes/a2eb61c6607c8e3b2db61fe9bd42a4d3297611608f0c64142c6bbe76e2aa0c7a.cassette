==== SCRIPT ====
f() { local x=x; tq='' local tx=tx; tq='' eval 'local ty=ty'; x='X' unset x; tx='TX' unset tx; ty='TY' unset ty; echo "x=$x tx=$tx ty=$ty tq=[${tq-unset}]"; }; f; echo "tx after=[${tx-unset}]"
g() { v=t local v; echo "local-same: [${v-unset}]"; x=1 local y=$x; echo "y=$y"; }; v=g; x=0; g; echo "v after: $v"
v=g; v=t export v; echo "export-same: $v"; bash -c 'echo "child: $v"'
a=1 export b=2; echo "a=[${a-unset}] b=$b"
