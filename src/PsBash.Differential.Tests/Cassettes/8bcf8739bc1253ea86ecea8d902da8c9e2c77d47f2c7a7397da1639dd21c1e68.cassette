==== SCRIPT ====
printf 'n=2+3\necho "w:$n"\nu=ab\necho "u:$u"\n' > w.sh
v=n; declare -i "$v"; source ./w.sh
unset n; declare -i n; declare -u u; source ./w.sh
c='n=4*4; u=cd'; eval "$c"; echo "c:$n $u"
f(){ local -i n; source ./w.sh; }; f; echo "after:$n"

