[[ 'ab' =~ a\x62 ]]; t e34 $?
[[ 'a(b' =~ a\(b ]]; echo "e40 $?"
[[ 'a+' =~ ^a\+$ ]]; echo "e41 $?"
[[ ab =~ ^a\b ]]; echo "e42 $?"
[[ 'a}' =~ a\} ]]; t L09 $?
[[ 'a\b' =~ a\\b ]]; t L12 $?
[[ 'a|b' =~ a\|b ]]; t L13 $?
