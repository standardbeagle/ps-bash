==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
while :; do exec >log1; break; done
echo after-while
exec >&5 5>&-
cat log1
