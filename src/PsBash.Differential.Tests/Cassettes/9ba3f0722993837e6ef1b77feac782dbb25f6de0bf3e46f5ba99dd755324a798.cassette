==== SCRIPT ====
declare -n ref=nothere; unset -n ref; echo "[${ref-unset}] st=$?"; declare -p ref >/dev/null 2>&1; echo "st=$?"; ref=v; echo "ref=$ref nothere=[${nothere-unset}]"
==== STDOUT ====
[unset] st=0
st=1
ref=v nothere=[unset]

