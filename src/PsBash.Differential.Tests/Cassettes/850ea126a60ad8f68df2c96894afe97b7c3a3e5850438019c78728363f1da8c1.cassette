==== SCRIPT ====
exec 2>/dev/null
for ((i=1/0;;)); do echo body0; break; done; echo "s0 st=$?"
for ((;1/0;)); do echo body1; break; done; echo "s1 st=$?"
n=0; for ((;n<3;n=n/0)); do echo body2 $n; n=1; done; echo "s2 st=$?"
for ((i=0;i<3;i++)); do echo ok$i; done; echo "s3 st=$?"
for ((i=0;i<2;i++)); do false; done; echo "s4 st=$?"

