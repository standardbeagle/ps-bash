==== SCRIPT ====
tv1=111; readonly tv2=222; export tv3=333
f1() { local tv5=555; echo '[readonly]'; readonly -p tv{0..5}; echo "st:$?"; echo '[export]'; export -p tv{0..5}; echo "st:$?"; echo '[local]'; local -p tv{0..5} 2>/dev/null; echo "st:$?"; local -p tv5 tv1 2>/dev/null; echo "st:$?"; }
f1; bash -c 'echo "child tv1=$tv1 tv5=[$tv5]"'; declare -p tv1 tv2 tv3
