PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 250
stdout-length: 37
stderr-length: 0
==== SCRIPT ====
trap 'echo URG' URG
kill -URG $$
trap - URG
kill -URG $$; echo "self $?"
kill -WINCH $$; kill -s CHLD $$; echo "st $?"
{ sleep 1; echo child; } & kill -URG $!; k=$?; wait $!; w=$?; echo "k $k"; echo "w $w"
kill -URG 999999 2>/dev/null; echo "none $?"
==== STDOUT ====
URG
self 0
st 0
child
k 0
w 0
none 1

==== STDERR ====

