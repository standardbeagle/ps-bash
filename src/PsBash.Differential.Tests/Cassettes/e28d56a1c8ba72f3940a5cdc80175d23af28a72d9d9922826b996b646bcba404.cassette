==== SCRIPT ====
n=0; while [ $n -lt 2 ]; do n=$((n+1)); done; echo "a st:$?"
xe=; if [ $xe ]; then :; fi; echo "b st:$?"
o='-lt'; i=0; while [ $i $o 2 ]; do i=$((i+1)); done; echo "d st:$?"
false; until [ $n = 2 ]; do :; done; echo "e st:$?"
