PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 892
stdout-length: 5451
stderr-length: 0
==== SCRIPT ====
for o in -Q --bogus; do
pwd $o; echo "pwd $?"; times $o; echo "times $?"; unset $o; echo "unset $?"
mapfile $o; echo "mapfile $?"; readarray $o; echo "readarray $?"; compgen $o; echo "compgen $?"
alias $o; echo "alias $?"; unalias $o; echo "unalias $?"; getopts $o; echo "getopts $?"
type $o; echo "type $?"; ulimit $o; echo "ulimit $?"; trap $o; echo "trap $?"
jobs $o; echo "jobs $?"; wait $o; echo "wait $?"; disown $o; echo "disown $?"
compopt $o; echo "compopt $?"; cd $o; echo "cd $?"; set $o; echo "set $?"; bind $o; echo "bind $?"
done 2>&1
{ read -Q; echo "read $?"; readonly -Q; echo "readonly $?"; export --bogus; echo "export $?"
enable -Q; echo "enable $?"; caller -Q; echo "caller $?"; builtin -Q; echo "builtin $?"
set -eQ; echo "set-e $?"; set +Q; echo "set+ $?"; local -Q; echo "local-top $?"
pwd -Q 2>/dev/null; echo "quiet $?"; read -Q 2>/dev/null; echo "quiet $?"; } 2>&1

