==== SCRIPT ====
d=$(mktemp -d); cd "$d"; cat > s.sh <<'PSBASH_EOF'
set -u; echo before; echo $x; echo after
echo line2=$?
f() { echo ${q:?boom}; echo inf; }; f; echo s2
echo end=$?
PSBASH_EOF
bash -i -c "$(cat s.sh)" 2>/dev/null; echo "rc=$?"; cd /; rm -rf "$d"
