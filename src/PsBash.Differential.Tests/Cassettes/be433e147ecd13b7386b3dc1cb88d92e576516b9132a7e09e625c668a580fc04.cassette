==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
qzpa=1 qzpb=2; a=(x y z); IFS=-; p "${!a[*]}" "${!qzp*}" "${!a[@]}" "${!qzp@}"; IFS=; p "${!a[*]}" "${!qzp*}"; unset IFS; p "${!a[*]}" "${!qzp*}"; p ${!a[*]} ${!qzp*}
