==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
( echo o 3>&1 1>&2 2>&3 ) 2>e
echo "e=$(cat e)"
==== STDOUT ====
