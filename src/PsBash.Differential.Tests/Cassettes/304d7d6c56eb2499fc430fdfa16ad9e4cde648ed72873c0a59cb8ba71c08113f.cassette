==== SCRIPT ====
ps1='foreach($i in 1..20){[Console]::Out.Write("o$i`n");[Console]::Error.Write("e$i`n")}'
pl='$|=1; for $i (1..20){print "o$i\n"; print STDERR "e$i\n"}'
d=$(mktemp -d)
timeout 120 perl -e "$pl" 2>"$d/f"; echo ---; cat "$d/f"
echo rc=$?
rm -rf "$d"
