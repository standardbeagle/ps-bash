==== SCRIPT ====
a=(1 2); read 'a[1]' <<< hi; echo "r=$? ${a[*]}"
i=0; read -r 'a[i+2]' <<< yo; echo "${a[*]}"
declare -A m; k=key; read "m[$k]" <<< v; echo "${m[key]}"
read 'a[0]' b <<< 'p q'; echo "${a[*]} b=$b"
read 'a[-9]' <<< x; echo "neg $?"
unset 'a[1]'; j='0+2'; test -v 'a[j]'; echo "v=$?"; test -v 'a[1]'; echo "h=$?"; test -v 'a[-1]'; echo "n=$?"
