==== SCRIPT ====
f() { local -n q=$1; echo "[${q[@]}] [${#q[@]}] [${!q}]"; q+=(z); q[0]=A; }
arr=(a b); f arr; echo "${arr[*]}"; nm=arr; f "$nm"; echo "${arr[*]}"
h() { local -n p="$1"; p=set_by_h; }; nm=tg; h "$nm"; echo "tg=$tg"
k() { local n=$1; local -n out=$n; out=$2; }; k tg kval; echo "tg=$tg"
m() { local -n mr=$1; mr=(x y); }; m "$nm"; declare -p tg
