==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
y=old; y=new printf '7<%s>\n' "$(echo $y)" "$y"; y=old; y=new printf '8<%s>\n' "$(y=in; echo $y)" "$y"; v=1 printf '12<%s>\n' $(v=2; echo $v) $(echo $v)
