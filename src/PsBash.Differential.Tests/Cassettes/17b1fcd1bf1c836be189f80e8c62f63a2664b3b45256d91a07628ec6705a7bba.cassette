==== SCRIPT ====
declare -n r; read r <<< tgt; declare -p r; r=5; echo "tgt=$tgt"
declare -n p; printf -v p %s hi; declare -p p
declare -n o; getopts ab o -a; echo "st=$?"; declare -p o
