export LC_ALL=C.UTF-8; shopt -s extglob
p=$(printf '@(%.0s' {1..40}); [[ x == $p ]]; echo $?; [[ $p == $p ]]; echo $?; v=x; echo "${v#$p}"; case $p in $p) echo m;; esac; p=$(printf '@(%.0s' {1..2000}); [[ x == $p ]]; echo $?; [[ $p == $p ]]; echo $?
