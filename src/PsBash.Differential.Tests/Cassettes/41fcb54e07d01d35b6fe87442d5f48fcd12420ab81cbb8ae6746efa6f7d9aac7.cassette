==== SCRIPT ====
declare b[2]=y; declare -p b
declare a[a[0]=1]=X; declare -p a
declare a[ a[2]=3 ]=Y 2>/dev/null; echo "st:$?"; declare -p a
declare 1x e[1]=2 2>/dev/null; echo "st:$?"; declare -p e
declare -a n[1]+=p r; declare -p n r
typeset t[1]=*; declare -p t
v='w x'; declare g[0]="$v"; declare -p g
declare -A m; declare m[k]=v m[j]+=w; declare -p m
declare -r ro[0]=1 2>/dev/null; echo "st:$?"
f() { local c[1]=z; declare d[0]=q; declare -p c d; }; f; declare -p c d 2>&1 | wc -l
