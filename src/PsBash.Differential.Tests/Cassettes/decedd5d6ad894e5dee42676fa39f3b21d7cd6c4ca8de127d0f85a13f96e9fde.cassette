==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
unset v w; p ${v:-${w:-'a b'}}; p ${v:-${w:-a b}}; p ${v:-${w:-"a b"}}; p ${v:-x${w:-'a b'}}
