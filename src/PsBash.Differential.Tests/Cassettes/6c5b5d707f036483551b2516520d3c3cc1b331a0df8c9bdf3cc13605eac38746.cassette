W="$(mktemp -d)"; cd "$W"
cat > s.sh <<'EOF'
let; echo "rc=$?"
.; echo "rc=$?"
source; echo "rc=$?"
. ./nofile_zz; echo "rc=$?"
. 2>err; echo "rc=$?"; cat err
EOF
bash s.sh 2>&1
bash -c 'let; echo "rc=$?"; source; echo "rc=$?"' 2>&1
cd /; rm -rf "$W"
