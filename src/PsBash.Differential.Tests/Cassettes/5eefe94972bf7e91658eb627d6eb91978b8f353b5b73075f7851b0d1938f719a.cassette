==== SCRIPT ====
jq -n -c '["aXbXc" | sub("X"; "-"), gsub("X"; "-"), gsub("x"; "-"; "i"), gsub("(?<l>[a-c])"; "<\(.l)>"), gsub(""; "-"), gsub("^"; ">"), sub("$"; "<"), gsub("X"; "1", "2"), [sub("b"; "1", "2")], gsub("[abc]"; empty)]'
