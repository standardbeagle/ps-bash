PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 483
stdout-length: 106
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 's'
printf '%s\n' 'F' > 's/f'
printf '%s\n' 'R' > 'ref'
} >/dev/null 2>&1
echo '== stdout'
{ :
touch -t 200101010000 s/f ref; touch -t 200101010000 s; cp -r --preserve=timestamps s t; cp -r s u; find t u -newer ref | sort
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
u
u/f
== exit 0
== fs
D .
F ./ref Ugo=
D ./s
F ./s/f Rgo=
D ./t
F ./t/f Rgo=
D ./u
F ./u/f Rgo=

