PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 570
stdout-length: 256
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' '{"a":1}' > 'a.json'
printf '%s\n' '[1,2]
3' > 'b.json'
printf '%s\n' '.a + 1' > 'prog.jq'
printf '%s\n' 'def f: . * 2;
# comment
.a | f' > 'multi.jq'
printf '%s\n' 'line1' > 'raw.txt'
printf '%s\n' '1 2 3' > 'stream.json'
} >/dev/null 2>&1
echo '== stdout'
{ :
jq -c '[., input_filename]' a.json b.json
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
