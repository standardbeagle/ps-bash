==== SCRIPT ====
cd "$(mktemp -d)"
{ echo a; i=0; while [ ! -f seen ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done; if [ -f seen ]; then echo b-after-other-side-read-a; else echo b-other-side-never-saw-a; fi; } | bash -c 'while read -r l; do echo "got $l"; touch seen; done'
echo rc=$?
