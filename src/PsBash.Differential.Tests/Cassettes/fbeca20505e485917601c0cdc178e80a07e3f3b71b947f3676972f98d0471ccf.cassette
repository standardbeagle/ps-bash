==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
eval 'echo e >&2 2>&1' >o 2>e
echo "o=[$(cat o)] e=[$(cat e)]"
echo after
==== STDOUT ====
o=[] e=[e]
after

