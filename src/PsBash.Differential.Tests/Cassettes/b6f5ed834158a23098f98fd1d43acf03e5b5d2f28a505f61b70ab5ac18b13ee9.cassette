==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
shopt -s nocasematch; v=ABC; printf '%s|' "${v/b/x}" "${v//[a-b]/x}" "${v#a}" "${v%c}" "${v^^b}"; [[ ABC == abc ]]; echo $?
