==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 'k/l'
printf '%s\n' 'x' > 'k/l/f'
} >/dev/null 2>&1
echo '== stdout'
{ :
echo n | rm -I -r k
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
== exit 0
== fs
D .
D ./k
D ./k/l
F ./k/l/f eAo=

