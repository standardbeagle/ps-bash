==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
true && ( exec >f; echo a; cat f >&2 ); echo "f=[$(cat f)]"
