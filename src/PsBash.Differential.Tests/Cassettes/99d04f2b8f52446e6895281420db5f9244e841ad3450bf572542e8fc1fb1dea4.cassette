==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 3>f3
{ echo g; } >&3
for i in 1; do echo l; done >&3
if true; then echo i; fi >&3
case a in a) echo c;; esac >&3
exec 3>&-
cat f3
==== STDOUT ====
g
l
i
c

