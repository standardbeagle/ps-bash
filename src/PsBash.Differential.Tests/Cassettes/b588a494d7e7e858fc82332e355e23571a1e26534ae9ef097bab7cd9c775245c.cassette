==== SCRIPT ====
cd "$(mktemp -d)" || exit; printf '#!/bin/sh\nexit 5\n' > p.sh; printf '#!/bin/sh\necho x\nexit 5\n' > q.sh; chmod +x p.sh q.sh; ./q.sh | grep --bogus 2>/dev/null | wc -l; echo "9 rc=$?"; echo x | grep --bogus 2>/dev/null | ./p.sh; echo "10 rc=$?"; ./q.sh | grep --bogus 2>/dev/null | ./p.sh > out; echo "11 rc=$?"; ./q.sh | ./p.sh | grep --bogus > out 2>/dev/null; echo "12 rc=$?"; ./q.sh | grep x | ./p.sh > out; echo "13 rc=$?"
