==== SCRIPT ====
f() { 'return' 6; }; f; echo "r=$?"
for i in 1 2; do "break"; done; echo "b=$i"
for i in 1 2; do \continue; echo no; done; echo "c=$i"
\set -- p q; echo "set: $*"
'shift'; echo "shift: $*"
\eval 'echo ev'
'read' rv <<< 'rr'; echo "read: $rv"
( 'exit' 4 ); echo "e=$?"

