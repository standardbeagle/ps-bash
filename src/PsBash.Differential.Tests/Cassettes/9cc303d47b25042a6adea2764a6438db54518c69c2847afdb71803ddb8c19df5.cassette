bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 531
stdout-length: 1506
stderr-length: 0
==== SCRIPT ====
cd "$(mktemp -d)" || exit
for n in 0 1 2; do
  nl=$(printf '%*s' "$n" '' | sed 's/ /\\n/g')
  for c in "jq -rn '\"a$nl\"'" "basename \$'a$nl'" "echo \$'a$nl'" "printf 'a$nl'"; do
    eval "$c" > o; echo "## $c >f: $(od -An -c o | tr -s ' ' | tr -d '\n')"
    eval "$c" | cat > o; echo "## $c |cat: $(od -An -c o | tr -s ' ' | tr -d '\n')"
    eval "$c" | grep -c ''
    v=$(eval "$c"; echo .); printf '%s' "$v" > o; echo "## $c \$(): $(od -An -c o | tr -s ' ' | tr -d '\n')"
    eval "$c"; echo "## $c screen END"
  done
done
cd / 
