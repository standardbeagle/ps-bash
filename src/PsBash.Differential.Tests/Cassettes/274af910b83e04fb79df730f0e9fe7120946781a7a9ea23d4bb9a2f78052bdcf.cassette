==== SCRIPT ====
s=$(printf 'a%.0s' {1..3000}); [[ $s =~ ^(a|aa)*$ ]]; echo "P1 $? ${#BASH_REMATCH[1]}"
[[ ${s}b =~ (a|aa)*c ]]; echo "P2 $?"
[[ $s =~ (a*)*b ]]; echo "P3 $?"
[[ $s =~ ((a*)*)*$ ]]; echo "P4 $? ${#BASH_REMATCH[1]}"
