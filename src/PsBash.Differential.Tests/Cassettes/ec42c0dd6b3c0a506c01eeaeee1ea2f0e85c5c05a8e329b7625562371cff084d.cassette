PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 353
stdout-length: 40
stderr-length: 0
==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=5x
case $s in [\d]) c=Y;; *) c=n;; esac
if [[ $s == [\d] ]]; then e=Y; else e=n; fi
if [[ $s != [\d] ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#[\d]}" "${s##[\d]}" "${s%[\d]}" "${s%%[\d]}" "${s/[\d]/X}" "${s//[\d]/X}" "${s/#[\d]/X}" "${s/%[\d]/X}" "${s^^[\d]}" "${s,,[\d]}" "${s^[\d]}"
echo

==== STDOUT ====
n|n|Y|5x|5x|5x|5x|5x|5x|5x|5x|5x|5x|5x|

==== STDERR ====

