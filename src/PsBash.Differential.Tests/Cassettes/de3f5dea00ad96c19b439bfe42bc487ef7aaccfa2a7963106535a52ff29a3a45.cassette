bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 409
stdout-length: 71
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 'p/q/r'
printf '%s\n' 'x' > 'p/q/r/f'
mkdir -p 'p'
printf '%s\n' 't' > 'p/top'
} >/dev/null 2>&1
echo '== stdout'
{ :
printf 'y\nn\ny\n' | rm -ir p
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
== exit 0
== fs
D .
D ./p
D ./p/q
D ./p/q/r
F ./p/q/r/f eAo=

