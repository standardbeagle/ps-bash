==== SCRIPT ====
s1(){ local -a r; read -a r <<< "x y z"; echo "s1:${r[*]}"; }; s1; echo "[${r[*]}]"; declare -p r 2>&1
ra=old; read -a ra <<< "x y"; echo "ra:$ra ${ra[1]}"; declare -p ra
read -a rb <<< "p q"; echo "rb:$rb ${rb[*]}"
mq=old; mapfile -t mq <<< "m1"; echo "mq:$mq"
h(){ read -a hr <<< "3 4"; }; h; echo "hr:${hr[*]}"
k(){ local -a ka=(0); kb; echo "k:${ka[*]}"; }; kb(){ read -a ka <<< "5 6"; }; k; echo "[${ka[*]-unset}]"

