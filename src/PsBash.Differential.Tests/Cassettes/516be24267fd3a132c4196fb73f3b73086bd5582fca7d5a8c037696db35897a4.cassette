p() { printf '<%s>' "$@"; printf ' #%s\n' "$#"; }
x={-01..2}; echo "$x"; x={1..010}; echo "$x"; x={1..5..0}; echo "$x"; x={+1..3}; echo "$x"
x={1..3}; echo "$x"; x=a{01..3}b; echo "$x"; x={a,b}; echo "$x"; x={a..c..1}; echo "$x"; x={'a',b}; echo "$x"
