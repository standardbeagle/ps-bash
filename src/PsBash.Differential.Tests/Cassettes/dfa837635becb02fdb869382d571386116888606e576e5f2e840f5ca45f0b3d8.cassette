==== SCRIPT ====
d=$(mktemp -d); echo x >"$d/t" >&2; echo y 2>"$d/u" >&2; echo z >&2 2>"$d/w"; { echo e >&2; } 2>"$d/g"; echo "t=[$(cat "$d/t")] u=[$(cat "$d/u")] w=[$(cat "$d/w")] g=[$(cat "$d/g")]"; rm -rf "$d"
