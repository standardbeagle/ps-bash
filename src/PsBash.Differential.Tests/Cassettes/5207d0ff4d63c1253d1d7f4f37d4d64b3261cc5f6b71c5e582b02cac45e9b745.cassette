p(){ declare -ga "gg=(1 2)"; declare -Ag "$1"; }; p 'gh=([a]=b)'; declare -p gg gh
g(){ eval 'declare -ga gx=(1)'; eval 'readonly -a rx=(2)'; c='declare -gA gm=([k]=v)'; eval "$c"; }; g; declare -p gx rx gm 2>&1
