==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
x=$( { echo o; echo e >&2; } 2>&1 | sed 's/^/P:/')
echo "x=$x"
echo after
