==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 'd1'
printf '%s\n' 'x' > 'd1/f'
printf '%s\n' 'k' > 'keep'
} >/dev/null 2>&1
echo '== stdout'
{ :
rm nosuch ./nosuch2 d1 nosuch/x 2>&1
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
