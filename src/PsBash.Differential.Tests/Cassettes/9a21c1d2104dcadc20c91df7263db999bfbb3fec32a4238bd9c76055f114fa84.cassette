==== SCRIPT ====
d=$(mktemp -d); cd "$d" || exit; mkdir -p sub/in; echo outer > data.txt; echo inner > sub/data.txt; here() { printf '%s PWD=%s\n' "$(pwd)" "$PWD" | sed "s|$d|D|g"; }; x=$(cd sub; here); echo "cmdsub [$x]"; here; ( cd sub; ( cd in; here ); here ); here; f() { cd sub; }; f | cat; here; echo a | { cd sub; cat; }; here; printf '1\n' | while read -r l; do cd sub; done; here; (cd sub); cat data.txt | grep -c . ; cat data.txt; ( cd sub; exit 3 ); echo "rc=$?"; here; pushd sub >/dev/null; ( pushd in >/dev/null; dirs -l | sed "s|$d|D|g" ); dirs -l | sed "s|$d|D|g"; ( popd >/dev/null; here ); here; popd >/dev/null; ( cd sub; rmdir in; cd in 2>/dev/null; here ); here; cd / && rm -rf "$d"
