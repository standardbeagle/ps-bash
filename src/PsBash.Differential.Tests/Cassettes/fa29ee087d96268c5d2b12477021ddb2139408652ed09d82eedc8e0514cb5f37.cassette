==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf 'a\nb\nc\nd\ne\nf\ng\nh\ni\nj\n' > a; printf 'a\nB\nc\nd\ne\nf\ng\nh\nI\nj\nk\n' > b
} >/dev/null 2>&1
echo '== stdout'
{ :
: > e1; diff e1 a > __out 2>/dev/null; echo "rc=$?"; sed 's/\t.*//' __out; rm -f __out; diff a e1 > __out 2>/dev/null; echo "rc=$?"; sed 's/\t.*//' __out; rm -f __out; diff -u e1 a > __out 2>/dev/null; echo "rc=$?"; sed 's/\t.*//' __out; rm -f __out; diff -u a e1 > __out 2>/dev/null; echo "rc=$?"; sed 's/\t.*//' __out; rm -f __out; diff -c e1 a > __out 2>/dev/null; echo "rc=$?"; sed 's/\t.*//' __out; rm -f __out; diff -c a e1 > __out 2>/dev/null; echo "rc=$?"; sed 's/\t.*//' __out; rm -f __out
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
