==== SCRIPT ====
cd "$(mktemp -d)" || exit 99
{ for i in 1 2; do { break; echo in; } | cat; echo "after ${PIPESTATUS[*]}"; echo "loop $i"; done
echo "end $?"
} 2>e.txt; sed 's/^.*line [0-9]*: //' e.txt
