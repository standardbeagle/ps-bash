==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=éx
case $s in [[:alpha:]]) c=Y;; *) c=n;; esac
if [[ $s == [[:alpha:]] ]]; then e=Y; else e=n; fi
if [[ $s != [[:alpha:]] ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#[[:alpha:]]}" "${s##[[:alpha:]]}" "${s%[[:alpha:]]}" "${s%%[[:alpha:]]}" "${s/[[:alpha:]]/X}" "${s//[[:alpha:]]/X}" "${s/#[[:alpha:]]/X}" "${s/%[[:alpha:]]/X}" "${s^^[[:alpha:]]}" "${s,,[[:alpha:]]}" "${s^[[:alpha:]]}"
echo

