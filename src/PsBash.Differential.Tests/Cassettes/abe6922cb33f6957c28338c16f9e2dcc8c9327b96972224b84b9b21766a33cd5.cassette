PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 396
stdout-length: 45
stderr-length: 0
==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=abc
case $s in @(ab|a)) c=Y;; *) c=n;; esac
if [[ $s == @(ab|a) ]]; then e=Y; else e=n; fi
if [[ $s != @(ab|a) ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#@(ab|a)}" "${s##@(ab|a)}" "${s%@(ab|a)}" "${s%%@(ab|a)}" "${s/@(ab|a)/X}" "${s//@(ab|a)/X}" "${s/#@(ab|a)/X}" "${s/%@(ab|a)/X}" "${s^^@(ab|a)}" "${s,,@(ab|a)}" "${s^@(ab|a)}"
echo

==== STDOUT ====
n|n|Y|bc|c|abc|abc|Xc|Xc|Xc|abc|Abc|abc|Abc|

==== STDERR ====

