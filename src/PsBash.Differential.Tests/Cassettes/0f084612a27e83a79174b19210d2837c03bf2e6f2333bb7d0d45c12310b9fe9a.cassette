==== SCRIPT ====
d=$(mktemp -d); printf '%s\n' '[Console]::Out.Write(($args -join "|") + "`n")' > "$d/a.ps1"; pwsh -NoProfile -NonInteractive -File "$d/a.ps1" -foo:bar --x=1 '' 'a b' 2>&1; echo rc=$?; rm -rf "$d"
==== STDOUT ====
-foo|bar|--x=1||a b
rc=0

