==== SCRIPT ====
cd "$(mktemp -d)"
printf '1\n2\n3\n4\n' > in
set -e
{ echo 1; echo 2; echo 3; echo 4; } | while read a; do echo "[$a]"; false; echo no; done | cat
echo after
