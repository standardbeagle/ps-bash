==== SCRIPT ====
{ for c in basename dirname whoami seq yes nohup xargs; do $c --bogus-xyz </dev/null; echo "$c $?"; $c -Q </dev/null; echo "$c $?"; done
seq 2 -w 4; echo "seq-op $?"; seq -s, 3; echo "seq-s $?"; seq -w -2 1; echo "seq-neg $?"
yes a -Q | head -1; echo "yes-late ${PIPESTATUS[0]}"
awk --bogus-xyz | head -2; echo "awk ${PIPESTATUS[0]}"; awk -Q 2>&1 | wc -l; echo "awk-n ${PIPESTATUS[0]}"
hostname --bogus-xyz | head -1; echo "hostname ${PIPESTATUS[0]}"
ps --bogus-xyz | head -1; echo "ps ${PIPESTATUS[0]}"
tput -Q | head -1; echo "tput ${PIPESTATUS[0]}"; tput --bogus | head -1; echo "tput ${PIPESTATUS[0]}"
which -Q >/dev/null; echo "which $?"; which --x >/dev/null; echo "which $?"
basename -z a/b | od -c | head -1; basename -a x/y z/w; basename -s .c a.c; dirname -z a/b | od -c | head -1
} 2>&1

