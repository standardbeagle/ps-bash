cd "$(mktemp -d)" || exit
cat > t.sh <<'EOF'
t() { printf '%s\n' "$1" > s.sh; bash s.sh 2>&1; echo "rc=$?"; }
t 'set -e; readonly r=1; f() { r=2; echo in; }; f; echo same
echo next'
t 'set -e
readonly q=1; q=2 || echo or
echo next'
t 'set -e
if true; then readonly q=1; q=2; echo same; fi
echo next'
t 'set -e
readonly q=1
( q=2; echo sub ); echo same
echo next'
t 'set -e
readonly q=1
y=$(q=2; echo sub); echo "same $?"
echo next'
t 'set -e
a[]=1; echo same
echo next'
t 'set -o posix
readonly x=1
x=2
echo hi'
t 'set -e
echo $((1/0)); echo same
echo next'
t 'readonly q=1
q=2; echo same
echo next'
EOF
{ bash t.sh; echo "rc=$?"; } 2>&1
