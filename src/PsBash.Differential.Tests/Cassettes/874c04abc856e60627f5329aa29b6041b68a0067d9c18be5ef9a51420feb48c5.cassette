bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 436
stdout-length: 100
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'a 1
b 2
a 3
' > 'data'
} >/dev/null 2>&1
echo '== stdout'
{ :
awk '{ print NR > "nr.out" } END{ close("nr.out"); while ((getline l < "nr.out") > 0) print "r:" l }' data
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
