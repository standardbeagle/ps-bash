==== SCRIPT ====
see() { echo "see $q $((q*2)) ${#q}"; [[ $q -gt 1 ]] && echo big; }
for q in 1 2; do see; done
for ((q = 3; q < 5; q++)); do see; done
printf '%s\n' 5 6 | while read q; do see; done
while read q; do see; done <<< 7
