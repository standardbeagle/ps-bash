==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'x' > 'x'
printf '%s\n' 'y' > 'y.txt'
printf '%s\n' 'h' > '.hid'
mkdir -p 'sub'
printf '%s\n' 'a' > 'sub/a1'
mkdir -p 'sub'
printf '%s\n' 'b' > 'sub/b1'
mkdir -p 'sub'
printf '%s\n' 'c' > 'sub/a[1]'
} >/dev/null 2>&1
echo '== stdout'
{ :
echo sub/a[1]
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
