==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
f() { read -r l <&5; echo "l=$l s=$?"; }
{ f 2>/dev/null; } 2>E
err E
==== STDOUT ====
l= s=1

