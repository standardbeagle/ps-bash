==== SCRIPT ====
f() { 'local' w=3; \local w2=4; "declare" -i n=2+3; echo "w=$w $w2 n=$n"; }; f
echo "out=${w-unset}${w2-unset}${n-unset}"
\export QX=1; 'export' QY=2; echo "QX=$QX QY=$QY"
"declare" -i di=2+3; echo "di=$di"

