__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p a/x/y a/b; mkdir -p z/w
} >/dev/null 2>&1
echo '== stdout'
{ :
rmdir -pv a/x//y/; echo rc=$?; rmdir -pv ./z/w; echo rc=$?
}
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
