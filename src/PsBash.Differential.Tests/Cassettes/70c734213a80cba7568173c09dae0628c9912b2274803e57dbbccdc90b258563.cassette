declare -A as=([a]=x); eval 'declare -a as=(1 2)' 2>/dev/null; echo st:$?; declare -p as
q=(1); declare -A q 2>/dev/null; echo st:$?; declare -A r; declare -a r 2>/dev/null; echo st:$?
sp=([3]=x); declare -A sp 2>/dev/null; echo st:$?
x=1; declare -A x; echo st:$?; declare -p x
y=(1 2); declare -a y=(3); echo st:$?; declare -p y
declare -A z=([k]=v); declare -A z=([j]=w); echo st:$?; declare -p z
w=(1 2); declare -A w v=(1 2) 2>/dev/null; echo st:$?; declare -p v
