PSBASH-ORACLE-CASSETTE v1
bash-version: wsl
exit-code: 0
script-length: 270
stdout-length: 28
stderr-length: 0
==== SCRIPT ====
cd "$(mktemp -d)" || exit; { kill -INT $BASHPID; echo after; } & wait $! 2>err; echo "INT $?"; grep -o -e 'User defined signal [12]' -e Hangup -e Killed -e Terminated -e Interrupt -e Quit -e 'Broken pipe' err; grep -c -i -e exception -e EndInvoke err; echo still-running
==== STDOUT ====
after
INT 0
0
still-running

