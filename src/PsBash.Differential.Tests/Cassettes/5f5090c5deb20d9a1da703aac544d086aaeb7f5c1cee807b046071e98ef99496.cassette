==== SCRIPT ====
cd "$(mktemp -d)"
printf 'declare -A M\n' > decl.sh
source ./decl.sh
M=([k]=v [j]=w); declare -p M
declare -A N; N=([n]=x); declare -p N
==== STDOUT ====
declare -A M=([k]="v" [j]="w" )
declare -A N=([n]="x" )

