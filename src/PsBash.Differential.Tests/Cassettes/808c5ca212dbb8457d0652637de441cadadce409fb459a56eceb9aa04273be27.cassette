==== SCRIPT ====
mkdir -p hb && printf '#!/bin/sh\necho hi\n' > hb/hashtool && chmod +x hb/hashtool
PATH="$PWD/hb:$PATH"
hash
type -P hashtool >/dev/null; command -v hashtool >/dev/null; hash
hashtool; hashtool
hash | cut -f1
hash -t hashtool >/dev/null; eval hashtool
hash | cut -f1
hash -t hashtool | grep -c 'hb.hashtool$'
hash -t hashtool nosuch 2>/dev/null | cut -f1; hash -t hashtool nosuch >/dev/null 2>&1; echo "t=$?"
hash -d hashtool; hash; hash -d hashtool 2>/dev/null; echo "d=$?"
hash hashtool; echo "add=$?"; hash | cut -f1
hash -r; hash; echo "r=$?"
hash -p some/where fake; hash -t fake

