==== SCRIPT ====
a=$(cat <<EOF
it's $((1+1))
EOF
)
b="$(cat <<-EOF
	it's ) tabbed
	EOF
)"
c="$(cat <<A; cat <<'B'
it's a
A
it's ) b
B
)"
printf '[%s]\n' "$a" "$b" "$c"
==== STDOUT ====
[it's 2]
[it's ) tabbed]
[it's a
it's ) b]

