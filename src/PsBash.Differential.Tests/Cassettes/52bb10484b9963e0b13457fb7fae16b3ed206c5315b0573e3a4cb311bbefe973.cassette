==== SCRIPT ====
gs() { q=5; }
ga() { (( q = 6 )); }
gr() { read q <<< 7; }
gp() { printf -v q '%s' 8; }
gl() { let q=9; }
gx() { q+=x; }
gu() { unset q; }
show() { echo "$1 [$q] $((q+0)) ${q:-empty}"; }
while read q; do for w in gs ga gr gp gl gx gu; do q=a; $w; show $w; done; done <<< a; echo "end [$q]"
