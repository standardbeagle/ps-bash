==== SCRIPT ====
d=$(mktemp -d); cd "$d" || exit; d=$(pwd -P); mkdir sub; touch f
readlink -n f sub 2>&1; echo "rc=$?"
readlink -fn f | sed "s|$d|D|g"; echo "|rc=$?"
readlink -fz f sub | tr '\0' '\n' | sed "s|$d|D|g"; echo "|"
realpath -z f nosuch/x 2>/dev/null | tr '\0' '\n' | sed "s|$d|D|g"; echo "|"
readlink -fq nosuch/x; echo "rc=$?"; readlink -fvq nosuch/x; echo "rc=$?"; readlink -fqv nosuch/x 2>&1; echo "rc=$?"
readlink -mfe sub/nosuch 2>&1; echo "rc=$?"; readlink -efm nosuch/x | sed "s|$d|D|g"; echo "rc=$?"
readlink 2>&1; echo "rc=$?"; realpath 2>&1; echo "rc=$?"; readlink -x f 2>&1; echo "rc=$?"
readlink --canon f 2>&1; echo "rc=$?"; realpath --canonicalize-m nosuch/x | sed "s|$d|D|g"
cd / && rm -rf "$d"
