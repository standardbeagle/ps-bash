PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 384
stdout-length: 30
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'A' > 'a'
printf '%s\n' 'B' > 'b'
printf '%s\n' 'C' > 'c'
} >/dev/null 2>&1
echo '== stdout'
{ :
echo n | rm -I a b c
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
== exit 0
== fs
D .

==== STDERR ====

