==== SCRIPT ====
cd "$(mktemp -d)" || exit
printf 'r1\nr2' > rr; printf 'r1\nr2\n' > rt
sed -n '$=' rr | od -An -c
sed p rr rr | od -An -c
sed -n 2p rr rr | od -An -c
sed -n 2p rr rt | od -An -c
sed -s -n '$=' rr rr | od -An -c
sed '$a X' rr rt | od -An -c
cp rr e1; sed -i '$a X' e1; od -An -c e1
cp rr e2; sed -i 's/r/R/' e2; od -An -c e2
cp rr e3; sed -i -n '$=' e3; od -An -c e3
sed -n 'w w1' rr; od -An -c w1
sed -n '1w w2' rr; od -An -c w2
sed -n 'w w3
$=' rr | od -An -c; od -An -c w3
printf 'a\0b' | sed -z -n '$=' | od -An -c
printf 'a\0b' | sed -z 'p' | od -An -c
printf 'a\nb' | sed -n '$=' - | od -An -c
cd / 
