==== SCRIPT ====
d=$(mktemp -d); cd "$d" || exit; printf 'a b\n' > f; printf 'a c\n' > g; for c in cat 'cat -n' head 'head -c1' tail 'tail -c2' wc 'wc -l' 'grep -H a' nl md5sum paste comm strings; do echo "## $c"; $c ./f f 2>&1; echo "rc=$?"; $c ./nosuch nosuch 2>&1; echo "rc=$?"; done; comm ./f g; head -n1 ./f f ./f; cd / && rm -rf "$d"
