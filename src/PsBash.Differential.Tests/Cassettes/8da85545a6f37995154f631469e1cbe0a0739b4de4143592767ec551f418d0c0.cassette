==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'k' > 'keep'
} >/dev/null 2>&1
echo '== stdout'
{ :
mkdir -m 999 d; echo "one=$?"; mkdir -m rwx a b; echo "two=$?"; mkdir -m '' e; echo "three=$?"
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
one=1
two=1
three=1
== exit 0
== fs
D .
F ./keep awo=

