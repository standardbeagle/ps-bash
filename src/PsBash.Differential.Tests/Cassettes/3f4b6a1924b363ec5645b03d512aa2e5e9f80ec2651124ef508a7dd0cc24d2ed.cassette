==== SCRIPT ====
cd "$(mktemp -d)" || exit
jq -rn '"a\n"' | od -An -c
jq -rn '"a\n"' | grep -c ''
jq -rn '"a\n"' | tail -n 1 | od -An -c
jq -rn '"a\n"' | sed = | od -An -c
jq -rn '"a\n"' | tr a b | od -An -c
basename $'a\n' | tee t | od -An -c; od -An -c t
v=$(basename $'a\n'; echo .); echo "[$v]"
x=$'a\n'; { echo "$x" >&2; } 2> e; od -An -c e
printf 'abc\n' | { read -n 1 y; cat; } > o; od -An -c o
cd / 
