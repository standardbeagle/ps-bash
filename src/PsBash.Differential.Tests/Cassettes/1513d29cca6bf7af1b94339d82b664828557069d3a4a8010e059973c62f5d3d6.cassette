bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 348
stdout-length: 30
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 'd/a'
printf '%s\n' 'x' > 'd/a/f'
} >/dev/null 2>&1
echo '== stdout'
{ :
rm -r --one d
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
== exit 0
== fs
D .

