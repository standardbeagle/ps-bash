==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
z='p:q r'; unset IFS; IFS=: printf '9<%s>\n' $(echo "[${IFS-unset}]") $z; IFS=; IFS=: printf '10<%s>\n' $(echo "[${IFS-unset}]") $z; unset IFS; echo "[${IFS-unset}]"
