==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
cd "$(mktemp -d)" || exit
touch .a b; echo @(.a|b) ?(.)a; echo @(b|.a); echo +(.)a; echo !(b)
==== STDOUT ====
.a b .a
.a b
.a
!(b)

