==== SCRIPT ====
cd "$(mktemp -d)" || exit 1; printf 'echo "lib says [$1]"\nX=1\n' > lib.sh
set -- a b; . ./lib.sh; echo "X=$X 1=$1"; source ./lib.sh p q; echo "after-args 1=$1 2=$2"
