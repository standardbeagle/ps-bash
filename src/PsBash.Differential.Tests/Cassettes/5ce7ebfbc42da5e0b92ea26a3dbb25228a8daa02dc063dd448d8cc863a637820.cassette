==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
echo a > a; echo b > b
} >/dev/null 2>&1
echo '== stdout'
{ :
touch b/; echo rc=$?; cp a a/; echo rc=$?; cp a b/; echo rc=$?; mv a b/; echo rc=$?; install a b/; echo rc=$?; ln a b/; echo rc=$?; ln -s a b/; echo rc=$?; ln -sf a b/; echo rc=$?; echo t | tee b/; echo rc=$?; echo s | sort -o b/; echo rc=$?; { echo r > b/; } 2>/dev/null; echo rc=$?; flock b/ true; echo rc=$?; cat b
}
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
