==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
{ for i in 1 2 3; do echo a$i; done > fa; } & for i in 1 2 3; do echo b$i; done > fb
wait
cat fa fb
