==== SCRIPT ====
shopt -s extglob
for s in '' a aa ab abab b; do [[ $s == ?(a) ]] && printf q; [[ $s == *(ab) ]] && printf s; [[ $s == +(ab) ]] && printf p; [[ $s == @(a|b) ]] && printf a; [[ $s != @(a|b) ]] && printf n; echo "|$s"; done
