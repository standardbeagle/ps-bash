==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
fx() { exec >log; }
fx
echo a
cat log 2>e
s=$?
exec >&5 5>&-
echo "s=$s"
err e
cat log
==== STDOUT ====
s=1
log: input file is output file
a

