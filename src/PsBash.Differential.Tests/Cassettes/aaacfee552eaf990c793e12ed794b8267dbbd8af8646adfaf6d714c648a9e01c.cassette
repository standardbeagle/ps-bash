PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 225
stdout-length: 33
stderr-length: 0
==== SCRIPT ====
cd "$(mktemp -d)"
bash -c 'echo a; i=0; while [ ! -s seen ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done; if [ -s seen ]; then echo b-after-other-side-read-a; else echo b-other-side-never-saw-a; fi' | tee seen
echo rc=$?
==== STDOUT ====
a
b-after-other-side-read-a
rc=0

