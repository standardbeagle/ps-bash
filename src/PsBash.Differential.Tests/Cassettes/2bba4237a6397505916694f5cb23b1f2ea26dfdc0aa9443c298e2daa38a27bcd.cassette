==== SCRIPT ====
export LC_ALL=C.UTF-8
cd "$(mktemp -d)" || exit; touch aa ab; g='@(aa|ab)'; echo $g; shopt -s extglob; echo $g; shopt -u extglob; v='*(a)'; touch 'x(a)'; echo x$v; echo $v
