==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 3>f
( exec 3>g; echo a >&3 )
echo b >&3
exec 3>&-
cat f
echo --
cat g
==== STDOUT ====
b
--
a

