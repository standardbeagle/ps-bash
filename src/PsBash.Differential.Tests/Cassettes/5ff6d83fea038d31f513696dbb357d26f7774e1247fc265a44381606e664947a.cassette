==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 's'
printf '%s\n' 'NEW' > 's/f'
mkdir -p 't/s'
printf '%s\n' 'OLD' > 't/s/f'
} >/dev/null 2>&1
echo '== stdout'
{ :
cp -rbv s t
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
