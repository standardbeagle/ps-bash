==== SCRIPT ====
false; echo "k18 $((1+1)) $?"
arr=( $(exit 3) ); echo "k46 $?"
declare -a arr2=( $(exit 3) ); echo "k47 $?"
false; eval ''; echo "k48 $?"
local zz 2>/dev/null; echo "k43 $?"
t4() { trap 'echo "t04 ret-trap $?"' RETURN; return 6; }; t4; echo "t04 after $?"; trap - RETURN
( set -e; trap 'false; echo intrap' EXIT; true ); echo "u31 $?"
