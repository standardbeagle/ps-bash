==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir -p 'e'
mkdir -p 'ne'
printf '%s\n' 'x' > 'ne/g'
printf '%s\n' 'x' > 'f'
} >/dev/null 2>&1
echo '== stdout'
{ :
rm -d e ne f 2>&1
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
