cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 3>t
{ echo y 2>/dev/null 2>&3 >&5; echo "s=$?"; } 2>E
exec 3>&-
echo t:
err t
err E
