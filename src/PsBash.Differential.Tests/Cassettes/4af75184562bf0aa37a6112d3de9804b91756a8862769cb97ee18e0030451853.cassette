==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '' > none
} >/dev/null 2>&1
echo '== stdout'
{ :
printf 'a:b\nc:d\ne\n' | column -s: -o '|' -c 40 | cat -A
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
a:b^Ic:d^Ie$
== exit 0
== fs
D .
F ./none

