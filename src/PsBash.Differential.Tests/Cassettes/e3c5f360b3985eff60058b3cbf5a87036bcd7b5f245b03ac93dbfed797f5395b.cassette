==== SCRIPT ====
t() { printf '%s rc=%s m=%s\n' "$1" "$2" "$(printf '%q,' "${BASH_REMATCH[@]}")"; }
v() { local n=$1 s=$2 re=$3; [[ $s =~ $re ]]; t "$n" $?; }
[[ abcbc =~ "a.*"c ]]; t e21 $?
[[ 'a.*c' =~ "a.*"c ]]; t e22 $?
[[ 'a\b' =~ 'a\b' ]]; t L11 $?
[[ 'x' =~ ["a-z"] ]]; t L20 $?
[[ '-' =~ ["a-z"] ]]; t L21 $?
[[ '^' =~ ["^"a] ]]; t L22 $?
[[ 'b' =~ ["^"a] ]]; t L23 $?
[[ 'a.c' =~ a"."c ]]; t L25 $?
[[ ab =~ "" ]]; t L26 $?
[[ 'a[' =~ a"[" ]]; t L28 $?
x='a.c'; [[ abc =~ "$x" ]]; t F9 $?
[[ abc =~ $x ]]; t F10 $?
[[ 'a.c' =~ ^"$x"$ ]]; t F11 $?
[[ '|' =~ $'|' ]]; t Q1 $?
