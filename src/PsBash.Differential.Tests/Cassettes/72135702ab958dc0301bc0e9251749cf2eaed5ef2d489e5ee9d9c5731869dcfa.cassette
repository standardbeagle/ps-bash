PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 696
stdout-length: 30
stderr-length: 0
==== SCRIPT ====
d=$(mktemp -d)
cd "$d"
cat > "$d/o.sh" <<'PSB_EOF'
perl -e 'print(($ENV{PSB_M} // "unset"), "\n")'
x=$(perl -e 'print(($ENV{PSB_M} // "unset"), "\n")'); echo "sub: $x"
perl -e 'print(($ENV{PSB_M} // "unset"), "\n")' & wait
perl -e 'print(($ENV{PSB_M} // "unset"), "\n")' | cat
true | perl -e 'print(($ENV{PSB_M} // "unset"), "\n")'
(exec perl -e 'print(($ENV{PSB_M} // "unset"), "\n")')
find . -maxdepth 0 -exec perl -e 'print(($ENV{PSB_M} // "unset"), "\n")' \;
env perl -e 'print(($ENV{PSB_M} // "unset"), "\n")'
command perl -e 'print(($ENV{PSB_M} // "unset"), "\n")'
timeout 60 perl -e 'print(($ENV{PSB_M} // "unset"), "\n")'
PSB_EOF
g() { . "$d/o.sh"; }
PSB_M=v g
echo rc=$?
cd /
rm -rf "$d"
