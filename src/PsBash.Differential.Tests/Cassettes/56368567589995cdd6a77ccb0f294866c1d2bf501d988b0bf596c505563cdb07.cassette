==== SCRIPT ====
cd "$(mktemp -d)" || exit; printf '%s\n' 'a$b' ab '*a' '{1}a' 'a{1,2' 'x)' aa > in; sed -E 's/a**/X/' in; sed -E 's/(a)*{2}/Y/' in; sed -E 's/a{1}{2}/Z/' in
