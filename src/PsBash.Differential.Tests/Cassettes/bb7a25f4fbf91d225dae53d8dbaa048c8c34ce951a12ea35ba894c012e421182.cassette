==== SCRIPT ====
declare -n ar; w=arr; ar=$w; arr=(a "b c" d)
echo "[${ar[@]}] [${ar[1]}] [${#ar[@]}] [${!ar[@]}] [${ar}] [${ar@a}]"
for e in "${ar[@]}"; do echo "e=$e"; done
x=("${ar[@]}"); echo "x=${#x[@]}"
echo "[${ar[@]:1}] [${ar[*]^^}] [${ar[@]/b/B}]"
[[ -v ar[1] ]]; echo "v1=$?"; [[ -v ar[7] ]]; echo "v7=$?"
ar+=(z); ar[0]=A; declare -p arr ar
declare -n as; z=m; as=$z; declare -A m=([k]=v)
echo "[${as[k]}] [${!as[@]}] [${as@a}]"
