PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 180
stdout-length: 12
stderr-length: 0
==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
exec >log
{ echo o; echo e >&2; } 2>&1 >f
exec >&5 5>&-
echo log:
cat log
echo f:
cat f
==== STDOUT ====
log:
e
f:
o

