==== SCRIPT ====
z=5
set -- y="$z" --o="a b" plain
printf '%s|' "$@"; echo
a=(k="$z" m); echo "${a[@]}"
for i in x q="$z" r=1; do echo $i; done
eval echo y="$z"
x='~'; eval y="$x"; [[ $y == /* ]] && echo expanded
