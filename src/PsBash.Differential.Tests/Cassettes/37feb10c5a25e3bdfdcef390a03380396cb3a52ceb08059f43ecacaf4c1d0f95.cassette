==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
s=Éa
case $s in [[:lower:]]) c=Y;; *) c=n;; esac
if [[ $s == [[:lower:]] ]]; then e=Y; else e=n; fi
if [[ $s != [[:lower:]] ]]; then ne=Y; else ne=n; fi
printf '%q|' "$c" "$e" "$ne" "${s#[[:lower:]]}" "${s##[[:lower:]]}" "${s%[[:lower:]]}" "${s%%[[:lower:]]}" "${s/[[:lower:]]/X}" "${s//[[:lower:]]/X}" "${s/#[[:lower:]]/X}" "${s/%[[:lower:]]/X}" "${s^^[[:lower:]]}" "${s,,[[:lower:]]}" "${s^[[:lower:]]}"
echo

