==== SCRIPT ====
p() { printf '[%s]' "$@"; echo; }; x=c; d='My Files'; p "a b"$x; p "$d"/$x; p $x"$d"; p \ $x
A='  abc  def  '; p ""$A""; p ''$A; p $A''; e=; p ""$e; p x $e; (IFS=' ,'; v=',a'; p ""$v); (IFS=; p ""$e)
