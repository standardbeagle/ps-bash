==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'A' > 'a'
printf '%s\n' 'B' > 'b'
mkdir -p 'd'
printf '%s\n' 'C' > 'd/c'
mkdir -p 'e'
} >/dev/null 2>&1
echo '== stdout'
{ :
ln -v a b d/
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
'd/a' => 'a'
'd/b' => 'b'
== exit 0
== fs
D .
F ./a QQo=
F ./b Qgo=
D ./d
F ./d/a QQo=
F ./d/b Qgo=
F ./d/c Qwo=
D ./e

