==== SCRIPT ====
(echo "${!a[@]-default}") 2>/dev/null; echo status=$?
a=(x); (echo "${!a[@]-default}"); echo status=$?
a=(x y z); (echo "${!a[@]-default}") 2>/dev/null; echo status=$?
a=(); (echo "${!a[@]-d}"); echo s=$?
a=(""); (echo "${!a[@]-d}") 2>/dev/null; echo s=$?
a=(b); b=; echo "[${!a[*]:-d}]" "[${!a[@]+set}]"
b=1; echo "${!a[@]#1}x"
IFS=:; a=(b c); (echo "${!a[*]-d}") 2>/dev/null; echo s=$?; IFS=' '
a=(x y); echo "${!a[@]}" "${!a[*]}"
