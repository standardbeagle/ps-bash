==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
exec 5>&1
{ exec >log1; }
echo after-group
exec >&5 5>&-
cat log1
==== STDOUT ====
after-group

