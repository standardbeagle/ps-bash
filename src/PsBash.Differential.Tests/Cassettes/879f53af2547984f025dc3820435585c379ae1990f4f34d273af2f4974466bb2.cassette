==== SCRIPT ====
function unshift { builtin eval -- "$1=(\"\${@:2}\" \"\${$1[@]}\")"; }
function shift_ { builtin eval -- "$1=(\"\${$1[@]:$((${2:-1}))}\")"; }
a=(1 2 3 4 5 6)
shift_ a 2
echo "${a[@]}"
unshift a 99
echo "${a[@]}"
