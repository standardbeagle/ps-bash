==== SCRIPT ====
cd "$(mktemp -d)" || exit; { kill -TERM $BASHPID; echo after; } & wait $! 2>err; echo "TERM $?"; grep -o -e 'User defined signal [12]' -e Hangup -e Killed -e Terminated -e Interrupt -e Quit -e 'Broken pipe' err; grep -c -i -e exception -e EndInvoke err; echo still-running
