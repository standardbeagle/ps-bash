==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
R() { exec 5>&1; fx() { exec >log; }; fx; echo a; eval "$1" 2>e; s=$?; exec >&5 5>&-; echo "s=$s"; err e; echo log:; cat log; }
R 'cat < log'
==== STDOUT ====
s=1
-: input file is output file
log:
a

