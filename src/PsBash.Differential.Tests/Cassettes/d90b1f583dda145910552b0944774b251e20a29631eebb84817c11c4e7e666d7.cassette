PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 411
stdout-length: 113
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'A' > 'a'
} >/dev/null 2>&1
echo '== stdout'
{ :
cp -L a n1; cp -P a n2; cp -H a n3; cp -d a n4; cp --dereference a n5; cp --no-dereference a n6
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
== exit 0
== fs
D .
F ./a QQo=
F ./n1 QQo=
F ./n2 QQo=
F ./n3 QQo=
F ./n4 QQo=
F ./n5 QQo=
F ./n6 QQo=

