==== SCRIPT ====
shopt -s extglob
for w in b c foo.log foo.txt xyz 'x(y' A; do case $w in @(a|b)) echo "$w arm1" ;; @(x\(y)) echo "$w esc" ;; !(*.log|xyz|A)) echo "$w arm2" ;; *) echo "$w default" ;; esac; done
==== STDOUT ====
b arm1
c arm2
foo.log default
foo.txt arm2
xyz default
x(y esc
A default

