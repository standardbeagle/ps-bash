==== SCRIPT ====
W="$(mktemp -d)"; cd "$W"; echo a {v}>f; echo b {w}>>g; echo "next=$((w - v))"; echo via-v >&$v; echo via-w >&$w; exec {v}>&-; exec {w}>&-; cat f g; cd /; rm -rf "$W"
