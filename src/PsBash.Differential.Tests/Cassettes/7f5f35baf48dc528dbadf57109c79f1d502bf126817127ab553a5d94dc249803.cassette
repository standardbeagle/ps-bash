export LC_ALL=C.UTF-8; shopt -s extglob
pp='@(a|ab)'; v=abc; printf '%s|' "${v##$pp}" "${v#$pp}" "${v/$pp/X}"; case $v in $pp*) echo Y;; *) echo n;; esac
