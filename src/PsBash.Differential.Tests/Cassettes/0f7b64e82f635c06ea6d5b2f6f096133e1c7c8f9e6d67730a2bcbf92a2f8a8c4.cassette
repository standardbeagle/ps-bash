==== SCRIPT ====
W="$(mktemp -d)"; cd "$W"
exec 2>&1
cat < nofile 2>/dev/null; echo "rc1=$?"
cat 2>/dev/null < nofile; echo "rc2=$?"
echo hi 2>err > nodir/y; echo "rc3=$?"; cat err
echo hi > nodir/y 2>err2; echo "rc4=$?"; ls
ls 2>&1 > nodir/q | sed 's/^/OUT:/'
echo hi > nodir/y > b; echo "rc6=$?"; ls
{ echo a; } 2>/dev/null > nodir/z; echo "rc7=$?"
while read l; do echo $l; done < nofile; echo "rc8=$?"
while read l; do echo $l; done 2>/dev/null < nofile; echo "rc9=$?"
x=$(< nofile); echo "rc10=$?"
x=$(< nofile 2>/dev/null); echo "rc11=$?"
read v < /nosuchfile; echo "rc12=$?"
fn() { echo in; }
fn > nodir/w; echo "rc13=$?"
{ echo a; } > nodir/z; echo "rc14=$?"
echo hi >> nodir/y; echo "rc15=$?"
echo hi &> nodir/y; echo "rc16=$?"
echo hi 2>/dev/null > nodir/y; echo "rc17=$?"

cd /; rm -rf "$W"
