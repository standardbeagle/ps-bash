PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 391
stdout-length: 104
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'A' > 'a'
mkdir -p 'd'
mkdir -p 'e'
ln a h
} >/dev/null 2>&1
echo '== stdout'
{ :
cp a h d; echo r1=$?; mv a h e; echo r2=$?
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
r1=0
r2=0
== exit 0
== fs
D .
D ./d
F ./d/a QQo=
F ./d/h QQo=
D ./e
F ./e/a QQo=
F ./e/h QQo=

