==== SCRIPT ====
v=$'a\r\nb'; echo $v | od -c | head -2
printf %s "$v" | od -c | head -2
echo "len=${#v}"
[[ $'a\r\nb' == $'a\r\nb' ]] && echo m1; [[ $'a\nb' == $'a\nb' ]] && echo m2; [[ $'a\rb' == $'a\rb' ]] && echo m3
[[ $v == $'a\r\nb' ]] && echo m4; x="$v"; [ "$x" = $'a\r\nb' ] && echo m5

