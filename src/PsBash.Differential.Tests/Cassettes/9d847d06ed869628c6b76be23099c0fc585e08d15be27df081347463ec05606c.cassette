PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 150
stdout-length: 11
stderr-length: 0
==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
{ exec >log; echo err >&2; } 2>&1 | sed 's/^/P:/'
echo log:
cat log
==== STDOUT ====
P:err
log:

==== STDERR ====

