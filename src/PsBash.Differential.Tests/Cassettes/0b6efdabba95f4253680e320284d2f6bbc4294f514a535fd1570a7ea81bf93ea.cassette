==== SCRIPT ====
d=$(mktemp -d); cd "$d"; cat > s.sh <<'PSBASH_EOF'
eval 'echo ${x!y}; echo in
echo eline2'; echo after-eval=$?
printf 'echo ${x!y}; echo in\necho sline2\n' > src.sh; . ./src.sh; echo after-src=$?
PSBASH_EOF
bash s.sh 2>/dev/null; echo "rc=$?"; cd /; rm -rf "$d"
