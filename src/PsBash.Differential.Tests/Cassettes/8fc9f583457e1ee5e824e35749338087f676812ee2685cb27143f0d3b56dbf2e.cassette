==== SCRIPT ====
d=$(mktemp -d); cd "$d"; cat > s.sh <<'PSBASH_EOF'
check() { r="${!1}"; echo "in $1"; }
x=y
check x; echo same=$?
check 'a[0'; echo same2
echo next=$?
check '!x'; echo same3
check 'x:-foo'
echo done
PSBASH_EOF
bash s.sh 2>/dev/null; echo "rc=$?"; cd /; rm -rf "$d"
==== STDOUT ====
in x
same=0
next=1
done
