bash-version: wsl
exit-code: 0
script-length: 525
stdout-length: 231
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
mkdir d; printf '#!/bin/sh\necho "args: $# [$1] [$2]"\nwhile read -r l; do echo "in: $l"; done\nexit 7\n' > d/hello; chmod +x d/hello; printf 'read -r l; echo "got $l"\n' > r.sh; printf 'plain\n' > doc; chmod -x doc
} >/dev/null 2>&1
echo '== stdout'
{ :
./doc; echo st=$?
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
