==== SCRIPT ====
cd "$(mktemp -d)" || exit 99
{ for i in 1 2; do ( trap 'break; echo in-trap' EXIT; echo sub ); echo "after $?"; echo "loop $i"; done
echo "end $?"
} 2>e.txt; sed 's/^.*line [0-9]*: //' e.txt
