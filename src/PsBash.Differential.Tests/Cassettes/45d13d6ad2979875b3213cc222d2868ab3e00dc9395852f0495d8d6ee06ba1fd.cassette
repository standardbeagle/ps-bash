==== SCRIPT ====
W="$(mktemp -d)"; cd "$W"
cat > s.sh <<'EOF'
for i in 1; do
  echo $i
  { :; } < nofileA
  echo after
done
if true; then
  echo x
  while false; do :; done < nofileB
fi
(
  { :; } < nofileE
)
echo z | while read l; do
  { :; } < nofileF
done
true && {
  { :; } < nofileG
}
case x in
  x)
    { :; } < nofileH
    ;;
esac
for ((i=0; i<1; i++)); do
  echo $i
  { :; } < nofileI
done
for i in 1; do
  :
done < nofileJ
while read l; do
  for j in 1; do :; done
  { :; } < nofileK
done <<EOF2
a
EOF2
echo end
EOF
bash s.sh >out 2>err; cat err; echo ---; cat out
cd /; rm -rf "$W"
