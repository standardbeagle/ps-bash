==== SCRIPT ====
trap 'echo got' RTMIN+1 RTMAX-3
kill -RTMIN+1 $$; echo "rc=$?"
kill -SIGRTMAX-3 $$; echo "rc=$?"
kill -RTMIN+99 $$ 2>/dev/null; echo "rc=$?"
