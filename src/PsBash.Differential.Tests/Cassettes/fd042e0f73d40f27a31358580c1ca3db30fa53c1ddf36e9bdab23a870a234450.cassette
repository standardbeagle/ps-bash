==== SCRIPT ====
d=$(mktemp -d); mkdir "$d/sub"; cd "$d/sub"
PWD=foo
echo "$PWD" $PWD ${PWD}
case "$(pwd)" in */sub) echo pwd-is-dir;; esac
cd ..; case "$PWD" in foo) echo stale;; *) echo cd-resets;; esac
