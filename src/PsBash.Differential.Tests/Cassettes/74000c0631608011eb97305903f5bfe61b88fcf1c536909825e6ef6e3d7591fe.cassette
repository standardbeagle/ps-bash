==== SCRIPT ====
printf '%s' '{"a":[1,2,3]}' | jq -c '.a[1] = 9, (.a[] |= . + 1), (.a |= map(. * 2)), (.a[1:] = [7]), (.a[-1] = 0), (del(.a[0])), (del(.a[0,2])), (del(.a[1:])), (delpaths([["a",0],["a",1]])), (.a | del(.[] | select(. == 2)))'
