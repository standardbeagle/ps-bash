PSBASH-ORACLE-CASSETTE v1
bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 406
stdout-length: 106
stderr-length: 0
==== SCRIPT ====
__fs_snap() { find . | LC_ALL=C sort | while IFS= read -r p; do if [ -d "$p" ]; then echo "D $p"; else echo "F $p $(base64 -w0 "$p")"; fi; done; }
d=$(mktemp -d) && cd "$d" && { :
printf '%s\n' 'A' > 'a'
printf '%s\n' 'B' > 'b'
mkdir -p 'd'
} >/dev/null 2>&1
echo '== stdout'
{ :
cp -v --reflink=auto a n1; cp -v --reflink=never a n2
} 2>/dev/null
echo "== exit $?"
echo '== fs'
__fs_snap
cd /; rm -rf "$d"
==== STDOUT ====
== stdout
'a' -> 'n1'
'a' -> 'n2'
== exit 0
== fs
D .
F ./a QQo=
F ./b Qgo=
D ./d
F ./n1 QQo=
F ./n2 QQo=

