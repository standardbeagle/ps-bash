==== SCRIPT ====
cd "$(mktemp -d)" || exit
err() { sed -E 's/^([^:]*: )?(line [0-9]+: )?//' "$1"; }
( exec 5>&1 >f; echo a; exec >&5; echo b ) && echo c
echo "f=[$(cat f)]"
