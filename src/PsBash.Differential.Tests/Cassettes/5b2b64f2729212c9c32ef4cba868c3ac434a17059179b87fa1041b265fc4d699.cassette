d=$(mktemp -d) && cd "$d" && { mkdir -p s/x t/s/x && echo new1 > s/x/f1 && echo new2 > s/x/f2 && echo old1 > t/s/x/f1; cp -rn s t 2>/dev/null; echo rc=$?; cat t/s/x/f1 t/s/x/f2; find . | sort; }; cd /; rm -rf "$d"
