bash-version: 5.2.21(1)-release
exit-code: 0
script-length: 359
stdout-length: 254
stderr-length: 0
==== SCRIPT ====
declare -n r; v=tg; r=$v; tg="hello world"
echo "[${r:-x}] [${r-x}] [${r:+set}] [${r+set}] [${#r}]"
echo "[${r#h}] [${r##*o}] [${r%d}] [${r%%o*}]"
echo "[${r/o/0}] [${r//o/0}] [${r/#h/H}] [${r/%d/D}]"
echo "[${r^^}] [${r^}] [${r,,}] [${r@Q}] [${r@U}] [${r:1:3}] [${r: -2}]"
for w in ${r}; do echo "w=$w"; done
unset tg; echo "[${r:-unset}] [${#r}] [${r+set}]"
