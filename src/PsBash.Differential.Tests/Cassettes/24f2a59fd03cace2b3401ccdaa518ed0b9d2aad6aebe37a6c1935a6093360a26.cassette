==== SCRIPT ====
cd "$(mktemp -d)"
p() { printf '%s' "$#:"; [ $# -gt 0 ] && printf '<%s>' "$@"; echo; }; x='a b'; e=; g='*'; HOME=/home/hh
set --; p "$@$e" "$e$@" "$@""$e" "$@""" "x$@"; e2=q; p "$@$e2"; set -- a b; p "$@$e" "$e$@"
