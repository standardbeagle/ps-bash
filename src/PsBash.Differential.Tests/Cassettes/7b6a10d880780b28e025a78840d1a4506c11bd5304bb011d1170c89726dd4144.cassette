p() { printf '<%s>' "$@"; printf ' #%s\n' "$#"; }
unset x u; echo {a,${x:-{b,c}}}
p {a,${x:-{b,c}}}; p {a,${x:-b,c}}; p x{a,${u:-{b}}}y; p {a,${u:-x}}{1,2}
