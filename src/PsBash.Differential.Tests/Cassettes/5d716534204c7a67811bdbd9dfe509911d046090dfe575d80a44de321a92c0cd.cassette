==== SCRIPT ====
exec 2>/dev/null
a=(1 2)
( echo ${a[1/0]} ); y=$(echo ${a[1/0]}); echo "same st=$? y=$y"
echo "next a=${a[*]}"
==== STDOUT ====
same st=1 y=
next a=1 2

