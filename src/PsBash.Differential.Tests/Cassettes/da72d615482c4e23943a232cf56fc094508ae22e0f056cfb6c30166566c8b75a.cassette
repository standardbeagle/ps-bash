==== SCRIPT ====
cd "$(mktemp -d)" || exit
printf 'abcdef' > rw; echo XY 1<> rw; od -c rw
cat 0<> newrw; echo "s=$?"; ls newrw
echo XY 0<> rw4 >&0; od -c rw4
printf 'abc\n' > rd; read -u 7 l 7<> rd; echo "7=$l"; od -c rd
exec 3>fm; exec 4>&3-; echo m >&4; exec 4>&-; cat fm

