==== SCRIPT ====
f(){ eval "$1"; }
f 'local -a a=(1 2); a+=(3); declare -A m; m[k]=v; echo "${a[*]} ${m[k]}"'; echo "[${a[*]}][${m[k]}]"
f 'local -a u=(1 2 3); unset "u[1]"; echo "u1:${u[*]}"; unset u; echo "u2:${u[*]-gone}"'; echo "[${u[*]-unset}]"
f 'local -a r; read -a r <<< "x y z"; echo "r:${r[*]}"; declare -a q; mapfile -t q < <(printf "1\n2\n"); echo "q:${q[*]}"'; echo "[${r[*]}][${q[*]}]"
f 'declare -A h=([a]=1); h[b]=2; h+=([c]=3); echo "h:${#h[@]}"; local -a e; e[3]=x; e[0]=y; echo "e:${!e[*]}"'; echo "[${#h[@]}][${e[*]}]"
ca(){ local -a z=(caller); cb; echo "ca:${z[*]}"; }; cb(){ eval 'z+=(callee)'; }; ca; echo "[${z[*]-unset}]"
ga=(top); eval 'ga+=(more)'; echo "ga:${ga[*]}"
gb(){ eval 'gl+=(x)'; }; gb; gb; echo "gl:${gl[*]}"
c='declare -ga gx=(glob)'; gc(){ local -a gx=(loc); eval "$c"; echo "in:${gx[*]}"; }; gc; echo "gx:${gx[*]}"
( sz=(1); eval 'sz+=(2)'; echo "sub:${sz[*]}" ); echo "[${sz[*]-none}]"

