==== SCRIPT ====
export LC_ALL=C.UTF-8; shopt -s extglob
cd "$(mktemp -d)" || exit
touch one.txt two.md; mkdir foo; touch foo/two.txt; GLOBIGNORE='*.txt'; echo * */*; GLOBIGNORE='[!o]*'; echo *; GLOBIGNORE='f*'; echo */*
