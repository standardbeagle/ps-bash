==== SCRIPT ====
cd "$(mktemp -d)" || exit
printf 'q' > u; printf 'a b\nc d\n' > f
for c in 'sed s/x/y/' 'awk 1' 'awk {print\ NF}' 'grep -c .' 'grep a' 'cut -c1-3' 'rev' 'paste -sd+' 'nl' 'sort' 'uniq' 'uniq -c' 'wc -l' 'head -n1' 'tail -n1' 'tac' 'tr a-z A-Z' 'cat -n' 'fold -w2' 'expand' 'column -t' 'xargs echo' 'strings' 'grep -n .' 'rg -N .' 'mapfile -t a; echo ${#a[@]}:${a[0]}' 'while IFS= read -r l; do echo "<$l>"; done'; do
  echo "## $c"
  { printf q; printf 'a b\n'; printf 'c'; printf ' d\n'; } | eval "$c"; echo "|rc=$?"
  cat u f | eval "$c"; echo "|rc=$?"
  { printf 'x\ny'; } | eval "$c"; echo "|rc=$?"
done 2>&1
cd / 
