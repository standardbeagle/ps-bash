<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>false</PublishAot>
    <AssemblyName>ps-bash-host</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PsBash.Host.Tests" />
    <InternalsVisibleTo Include="PsBash.Shell.Tests" />
    <InternalsVisibleTo Include="PsBash.Escalation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core embeds PsBash.Cmdlets.dll (per-TFM) as a manifest resource and
         ModuleExtractor extracts the matching variant alongside PsBash.psm1.
         SdkRunspace imports it from that one canonical extracted path — no
         beside-host-binary copy, no Get-Module probe (REFACTOR-5). The Host
         therefore needs no direct PsBash.Cmdlets ProjectReference and no
         Cmdlets.dll Content staging; the cmdlets ship inside PsBash.Core.dll. -->
    <ProjectReference Include="..\PsBash.Core\PsBash.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Do NOT add <PrivateAssets>all</PrivateAssets> here. It is idiomatic on a bare
         System.Management.Automation reference (which this used to be), but on the SDK
         meta-package it EXCLUDES THE RUNTIME ASSETS FROM PUBLISH: a self-contained
         `dotnet publish src/PsBash.Host` then emits a host with no
         System.Management.Automation.dll at all, which dies at startup with
         "Could not load file or assembly 'System.Management.Automation'". That is exactly
         the command publish.yml ships with, and a local `dotnet build` hides it — a dev run
         resolves SMA from the NuGet cache through runtimeconfig.dev.json probing paths, so
         only a published/installed layout fails. The attribute was carried over when
         bb8291f upgraded this reference to Microsoft.PowerShell.SDK precisely "so all
         runtime DLLs are included in the output", silently defeating that intent.
         Guarded by PublishRecipeGuardTests. -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
    <!-- Override the vulnerable SQLitePCLRaw.lib.e_sqlite3 that Microsoft.Data.Sqlite pulls
         transitively. GHSA-2m69-gcr7-jv3q (high severity, NU1903) covers the whole 2.1.x line
         (vulnerable range <= 2.1.11), so the old 2.1.11 pin was itself flagged. The 3.0.x bundle
         is the first version outside the advisory range. /warnaserror in the AOT build-binaries
         job promotes the NuGet-audit warning to an error (broke the win-x64 publish for v0.10.16),
         so this must stay ahead of 2.1.11. Microsoft.Data.Sqlite 9.x only needs core >= 2.1.10,
         which 3.0.x satisfies, and the SQLitePCLRaw raw-provider API is stable across 2.1 -> 3.0. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Single source of truth for bash flag specs lives in PsBash.Module/BashFlagSpecs.json
         (also embedded into PsBash.Core + loaded by the psm1). Embed it here under the resource
         name FlagSpecs.cs reads, so the host and the module never drift. -->
    <EmbeddedResource Include="..\PsBash.Module\BashFlagSpecs.json"
                      LogicalName="PsBash.Host.Resources.FlagSpecs.json" />
    <EmbeddedResource Include="Resources\SdkRunspaceSetup.ps1"
                      LogicalName="PsBash.Host/SdkRunspaceSetup.ps1" />
  </ItemGroup>
</Project>
