<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>false</PublishAot>
    <AssemblyName>ps-bash-host</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PsBash.Host.Tests" />
    <InternalsVisibleTo Include="PsBash.Shell.Tests" />
    <InternalsVisibleTo Include="PsBash.Escalation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PsBash.Core\PsBash.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\FlagSpecs.json" />
  </ItemGroup>

  <!-- dotnet publish omits Microsoft.PowerShell.SDK runtime assemblies for this
       net10 host, even though CopyLocalLockFileAssemblies puts them in the RID
       build output. Copy them into the publish directory so ps-bash-host can
       resolve System.Management.Automation and the Microsoft.PowerShell.* DLLs
       from its side-by-side install layout. -->
  <Target Name="CopyPowerShellSdkAssembliesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_PowerShellSdkPublishAssemblies Include="$(OutputPath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PowerShellSdkPublishAssemblies)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
