<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ps-bash-host</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- IL2026 NoWarn intentionally removed for AOT probe to capture all warnings -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PsBash.Host.Tests" />
    <InternalsVisibleTo Include="PsBash.Shell.Tests" />
    <InternalsVisibleTo Include="PsBash.Escalation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PsBash.Core\PsBash.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\FlagSpecs.json" />
  </ItemGroup>
</Project>
