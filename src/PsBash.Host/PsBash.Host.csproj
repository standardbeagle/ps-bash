<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>false</PublishAot>
    <AssemblyName>ps-bash-host</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PsBash.Host.Tests" />
    <InternalsVisibleTo Include="PsBash.Shell.Tests" />
    <InternalsVisibleTo Include="PsBash.Escalation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core embeds PsBash.Cmdlets.dll (per-TFM) as a manifest resource and
         ModuleExtractor extracts the matching variant alongside PsBash.psm1.
         SdkRunspace imports it from that one canonical extracted path — no
         beside-host-binary copy, no Get-Module probe (REFACTOR-5). The Host
         therefore needs no direct PsBash.Cmdlets ProjectReference and no
         Cmdlets.dll Content staging; the cmdlets ship inside PsBash.Core.dll. -->
    <ProjectReference Include="..\PsBash.Core\PsBash.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\FlagSpecs.json" />
    <EmbeddedResource Include="Resources\SdkRunspaceSetup.ps1"
                      LogicalName="PsBash.Host/SdkRunspaceSetup.ps1" />
  </ItemGroup>
</Project>
