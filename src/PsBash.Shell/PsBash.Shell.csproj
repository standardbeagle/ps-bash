<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StripSymbols>true</StripSymbols>
    <AssemblyName>ps-bash</AssemblyName>
    <!-- IL2104/IL3053: aggregate trim/AOT analysis warnings from third-party assemblies
         (System.Management.Automation, ApplicationInsights, Newtonsoft.Json, etc.) that
         are analyzed by ILC because Host references them, but are not called from the
         AOT launcher and are trimmed away at publish time. -->
    <IlcSuppressWarnings>IL2104;IL3053</IlcSuppressWarnings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PsBash.Shell.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PsBash.Core\PsBash.Core.csproj" />
    <ProjectReference Include="..\PsBash.Host\PsBash.Host.csproj" />
  </ItemGroup>

  <!-- Copy Host's full output so ps-bash-host can run from this output directory
       in dev/test scenarios (both binaries in same dir = WorkerFactory finds the host). -->
  <Target Name="CopyHostRuntimeAssets" AfterTargets="Build">
    <PropertyGroup>
      <_HostOutDir>$(MSBuildThisFileDirectory)..\PsBash.Host\bin\$(Configuration)\$(TargetFramework)\</_HostOutDir>
      <!-- Apphost filename differs by platform -->
      <_HostExeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">ps-bash-host.exe</_HostExeName>
      <_HostExeName Condition="!$([MSBuild]::IsOSPlatform('Windows'))">ps-bash-host</_HostExeName>
    </PropertyGroup>
    <ItemGroup>
      <!-- Top-level DLLs including ps-bash-host.dll; exclude other PsBash.* because
           those come from project references and are already in OutDir. -->
      <_HostDlls Include="$(_HostOutDir)*.dll"
                 Exclude="$(_HostOutDir)PsBash.*.dll" />
      <!-- Platform-specific runtime assets -->
      <_HostRuntimeFiles Include="$(_HostOutDir)runtimes\**\*" />
      <!-- Host executable + runtime config so ps-bash-host is launchable from OutDir -->
      <_HostExeFiles Include="$(_HostOutDir)$(_HostExeName)" />
      <_HostExeFiles Include="$(_HostOutDir)ps-bash-host.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_HostRuntimeFiles)"
          DestinationFiles="@(_HostRuntimeFiles->'$(OutDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_HostExeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
