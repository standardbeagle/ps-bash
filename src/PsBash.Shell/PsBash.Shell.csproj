<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StripSymbols>true</StripSymbols>
    <AssemblyName>ps-bash</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PsBash.Shell.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PsBash.Core\PsBash.Core.csproj" />
    <ProjectReference Include="..\PsBash.Host\PsBash.Host.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PublishHostSidecar" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_HostRuntimeOutDir>$(MSBuildThisFileDirectory)..\PsBash.Host\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</_HostRuntimeOutDir>
    </PropertyGroup>
    <MSBuild Projects="..\PsBash.Host\PsBash.Host.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishAot=false" />
    <ItemGroup>
      <_PublishedHostFiles Include="$(_HostRuntimeOutDir)**\*"
                           Exclude="$(_HostRuntimeOutDir)publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedHostFiles)"
          DestinationFiles="@(_PublishedHostFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Host's full output (DLLs + platform runtimes) into the Shell's
       OutDir so ps-bash-host can load its managed entrypoint and NuGet
       assemblies when launched from this build output. The publish path
       is handled by PublishHostSidecar (AfterTargets="Publish"), which
       copies the RID-flavored Host build into PublishDir. We avoid
       $(PublishDir) here because MSBuild assigns it a default value
       during a plain `dotnet build`, which caused this target to drop
       the Host DLLs into bin/.../publish/ instead of OutDir. -->
  <Target Name="CopyHostRuntimeAssets" AfterTargets="Build">
    <PropertyGroup>
      <_HostOutDir>$(MSBuildThisFileDirectory)..\PsBash.Host\bin\$(Configuration)\$(TargetFramework)\</_HostOutDir>
      <_HostDestinationDir>$(OutDir)</_HostDestinationDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Host apphost support files and top-level DLLs (Newtonsoft.Json, PS cmdlets, etc.). -->
      <_HostFiles Include="$(_HostOutDir)ps-bash-host.*" />
      <_HostFiles Include="$(_HostOutDir)*.dll"
                  Exclude="$(_HostOutDir)PsBash.*.dll" />
      <!-- PsBash.Cmdlets.dll ships with the host so SdkRunspace.Create can
           Import-Module it without depending on an installed PSGallery module
           (RC-3). The PsBash.*.dll exclude above otherwise filters it out. -->
      <_HostFiles Include="$(_HostOutDir)PsBash.Cmdlets.dll"
                  Condition="Exists('$(_HostOutDir)PsBash.Cmdlets.dll')" />
      <!-- Platform-specific runtime assets -->
      <_HostRuntimeFiles Include="$(_HostOutDir)runtimes\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostFiles)"
          DestinationFolder="$(_HostDestinationDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_HostRuntimeFiles)"
          DestinationFiles="@(_HostRuntimeFiles->'$(_HostDestinationDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    After PublishHostSidecar copies the host's runtimes/ tree into our publish output,
    flatten the PowerShell SDK built-in modules from runtimes/<rid-group>/lib/net8.0/Modules
    to a $PSHOME-relative Modules/ folder. See PsBash.Host.csproj for the full rationale.
  -->
  <Target Name="FlattenPSModulesAfterPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_ModulesRidGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">win</_ModulesRidGroup>
      <_ModulesRidGroup Condition="'$(_ModulesRidGroup)' == ''">unix</_ModulesRidGroup>
      <_ModulesSourceDir>$(PublishDir)runtimes\$(_ModulesRidGroup)\lib\net8.0\Modules\</_ModulesSourceDir>
    </PropertyGroup>
    <ItemGroup>
      <_PSModuleFiles Include="$(_ModulesSourceDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PSModuleFiles)"
          DestinationFiles="@(_PSModuleFiles->'$(PublishDir)Modules\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_PSModuleFiles)' != ''" />
  </Target>

</Project>
