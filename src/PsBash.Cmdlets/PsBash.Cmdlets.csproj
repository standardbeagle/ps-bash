<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Binary pwsh module. Multi-targets net8.0 (PowerShell 7.4 JIT host) and
    net10.0 (ps-bash-host's SDK runspace). Single-targeting net8.0 caused the
    in-process ps-bash-host (net10.0) to load the cmdlets DLL alongside its
    own net10.0 PsBash.Transpiler, dragging in a second net8.0 copy into the
    process — type identity divergence then wedged Import-Module on the host's
    SDK runspace. Multi-targeting lets the assembly resolver pick the matching
    TFM when the host imports the cmdlets module.
    This project references PsBash.Transpiler (not PsBash.Core): the parser +
    transpiler surface is a leaf project both Core and Cmdlets depend on, which
    breaks the Core<->Cmdlets cycle and lets Core embed PsBash.Cmdlets.dll.
    AOT publishing is intentionally disabled because the cmdlets in this assembly use
    ScriptBlock.Create + InvokeScript, which are reflection-heavy and not AOT-safe.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>false</PublishAot>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableExperimentalBashEval Condition="'$(EnableExperimentalBashEval)' == ''">false</EnableExperimentalBashEval>

    <!-- Strata (the Format-Styled cmdlet) is consumed from the local feed
         ../strata/local-feed until Strata ships to nuget.org. Auto-enable when
         that feed is present; CI runners lack it, so the default-off build
         excludes the Strata.* package refs AND FormatStyledCommand.cs, leaving
         restore with nothing to fetch from the missing feed (stays green).
         Force explicitly with -p:UseStrata=true|false. -->
    <StrataLocalFeed Condition="'$(StrataLocalFeed)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\strata\local-feed'))</StrataLocalFeed>
    <!-- The local feed (../strata/scripts/pack-local.sh) packs unprefixed Strata.* IDs
         (the project PackageIds; namespaces also Strata.*). nuget.org carries a frozen
         StandardBeagle.Strata.* 0.1.0-alpha.1 widgets release, but ps-bash only ever
         consumes Strata from the local feed (CI lacks the feed → UseStrata=false → these
         refs and FormatStyledCommand.cs are excluded). So pin to the newest *.nupkg in the
         local feed. One source so all six refs move together. -->
    <StrataVersion Condition="'$(StrataVersion)' == ''">0.2.1-dev</StrataVersion>
    <UseStrata Condition="'$(UseStrata)' == '' and Exists('$(StrataLocalFeed)')">true</UseStrata>
    <UseStrata Condition="'$(UseStrata)' == ''">false</UseStrata>
    <!-- Add the Strata local feed as a restore source ONLY when enabled. The feed
         is deliberately not in nuget.config because a missing local source is a
         hard NU1301 restore error that would break CI. -->
    <RestoreAdditionalProjectSources Condition="'$(UseStrata)' == 'true'">$(RestoreAdditionalProjectSources);$(StrataLocalFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableExperimentalBashEval)' != 'true'">
    <Compile Remove="InvokeBashEvalCommand.cs" />
  </ItemGroup>

  <!-- The styled-output cmdlets (and their shared helpers) compile only when Strata is
       available (see UseStrata); their only consumers are these cmdlets. -->
  <ItemGroup Condition="'$(UseStrata)' != 'true'">
    <Compile Remove="FormatStyledCommand.cs" />
    <Compile Remove="ShowStyledCommand.cs" />
    <Compile Remove="StyledInteractiveSession.cs" />
    <Compile Remove="StyledNode.cs" />
    <Compile Remove="StyledStyles.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PsBash.Transpiler\PsBash.Transpiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.4.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Strata styling engine (Format-Styled). Consumed from ../strata/local-feed
       via nuget.config until Strata ships to nuget.org. Repack with
       ../strata/scripts/pack-local.sh after editing Strata. Spectre.Console + ExCSS
       flow in transitively from Strata.Render.Spectre / Strata.Css. Gated on
       UseStrata so CI (no local feed) restores without these packages. -->
  <ItemGroup Condition="'$(UseStrata)' == 'true'">
    <PackageReference Include="Strata.Css" Version="$(StrataVersion)" />
    <PackageReference Include="Strata.Adapters.PSObject" Version="$(StrataVersion)" />
    <PackageReference Include="Strata.Properties.Styling" Version="$(StrataVersion)" />
    <PackageReference Include="Strata.Render.Spectre" Version="$(StrataVersion)" />
    <!-- Yoga layout pass: required for the 3-arg SpectreProjection.Project overload
         that honors `display: grid` (Format-Styled grid / property-list rendering). -->
    <PackageReference Include="Strata.Layout.Yoga" Version="$(StrataVersion)" />
    <!-- Interaction: the `command:` property descriptor so the button/expansion stylesheets (which
         declare `command:` bindings) parse. Only the descriptor is used (registration is pure);
         System.Reactive flows in transitively but is never exercised. -->
    <PackageReference Include="Strata.Interaction" Version="$(StrataVersion)" />
  </ItemGroup>

  <!-- Built-in Format-Styled stylesheets, embedded so they travel with the DLL
       regardless of deployment layout. Logical names: PsBash.Cmdlets.styles.<name>.css.
       Only embedded when Strata (and thus Format-Styled) is built. -->
  <ItemGroup Condition="'$(UseStrata)' == 'true'">
    <EmbeddedResource Include="styles\*.css" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PsBash.Cmdlets.psd1" CopyToOutputDirectory="Always"
          Condition="'$(EnableExperimentalBashEval)' != 'true'" />
    <None Include="PsBash.Cmdlets.Experimental.psd1"
          Link="PsBash.Cmdlets.psd1"
          TargetPath="PsBash.Cmdlets.psd1"
          CopyToOutputDirectory="Always"
          Condition="'$(EnableExperimentalBashEval)' == 'true'" />
    <None Include="..\PsBash.Module\PsBash.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PsBash.Module\PsBash.psm1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PsBash.Module\PsBash.Format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PsBash.Module\BashFlagSpecs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
