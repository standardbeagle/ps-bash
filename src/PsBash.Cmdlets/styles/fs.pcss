/* fs — filesystem objects (Get-ChildItem / FileInfo / DirectoryInfo).
 *
 * `Get-ChildItem | Format-Styled fs` renders a CURATED, human-oriented table — Format-Styled
 * builds it automatically for FileSystemInfo rows (no -Property needed):
 *   - Name      type emoji + name        (📁 dir  📘 code  🖼 image  🎵 audio  📦 archive  …)
 *   - Size      human size + a ▰▱ meter   (a log-scaled visual indicator of relative file size)
 *   - Modified  relative time             (5m ago / 3h ago / 2d ago / "Jun 12")
 * Each row carries a `class` naming its type bucket; the rules below colour by it. Pass an explicit
 * -Property (or a different sheet) to opt out and get the raw property grid.
 *
 * Also drives the interactive viewer (Show-Styled / -Interactive): arrows move focus, Enter toggles
 * :expanded, the focused row's buttons fire `open` / `cd`. `:focused` / `command:` are inert under
 * the static projection but harmless.
 */

/* Base colours by Strata Kind (also covers rows that have no `class`). */
DirectoryInfo { color: brightblue; font-weight: bold }
FileInfo      { color: white }

/* File-type buckets (set by Format-Styled's filesystem view; also project your own `class`). */
.dir     { color: brightblue;    font-weight: bold }
.image   { color: brightmagenta }
.video   { color: magenta }
.audio   { color: brightcyan }
.archive { color: yellow }
.app     { color: brightgreen;   font-weight: bold }
.exe     { color: brightgreen;   font-weight: bold }   /* legacy alias for .app */
.script  { color: green }
.code    { color: brightcyan }
.doc     { color: white }
.data    { color: brightyellow }
.text    { color: white }
.symlink { color: cyan }
.large   { color: brightyellow }                        /* legacy size accent */

/* Hidden last so it dims regardless of type. */
.hidden  { color: gray }

/* The expandable detail block (size / dates / attributes / acl). */
Detail     { color: gray }
Detail .key { color: cyan }
:expanded > Detail { color: white }

/* Action buttons — bracket chrome statically; focusable + bound interactively. */
Button         { color: brightcyan }
Button:focused { color: black; background: brightcyan }

/* Full-screen focus cursor + key bindings (interactive only). */
:focused { color: black; background: brightcyan }
Surface {
    command: "navigate-down"  when "key.ArrowDown";
    command: "navigate-up"    when "key.ArrowUp";
    command: "navigate-down"  when "key.j";
    command: "navigate-up"    when "key.k";
    command: "toggle-expand"  when "key.Enter";
    command: "open"           when "key.o";
    command: "cd"             when "key.c";
}
