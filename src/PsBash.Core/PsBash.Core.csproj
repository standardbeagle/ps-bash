<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NuGet package metadata -->
    <PackageId>PsBash.Core</PackageId>
    <Version>0.9.12</Version>
    <Authors>StandardBeagle</Authors>
    <Description>Bash-to-PowerShell transpiler library. Parses bash commands into an AST (based on Oils/OSH) and emits equivalent PowerShell. Use as a library in terminal emulators, AI agents, or any .NET app that needs bash compatibility on top of PowerShell.</Description>
    <PackageTags>bash;powershell;transpiler;parser;shell;terminal</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/standardbeagle/ps-bash</PackageProjectUrl>
    <RepositoryUrl>https://github.com/standardbeagle/ps-bash</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\PsBash.Module\PsBash.psd1" LogicalName="PsBash.Module/PsBash.psd1" />
    <EmbeddedResource Include="..\PsBash.Module\PsBash.psm1" LogicalName="PsBash.Module/PsBash.psm1" />
    <EmbeddedResource Include="..\PsBash.Module\PsBash.Format.ps1xml" LogicalName="PsBash.Module/PsBash.Format.ps1xml" />
    <EmbeddedResource Include="..\PsBash.Module\BashFlagSpecs.json" LogicalName="PsBash.Module/BashFlagSpecs.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PsBash.Transpiler\PsBash.Transpiler.csproj" />
    <!-- Build PsBash.Cmdlets before Core so EmbedCmdletsDll can pick up its
         per-TFM build output. ReferenceOutputAssembly=false: Core does NOT
         link the cmdlets at compile time — it embeds the DLLs as manifest
         resources and ModuleExtractor extracts the TFM-matching one at
         runtime. Both projects multi-target net8.0;net10.0, so the matching
         TFM is built. The dependency graph stays acyclic
         (Core->Cmdlets->Transpiler, Core->Transpiler). -->
    <ProjectReference Include="..\PsBash.Cmdlets\PsBash.Cmdlets.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Embed the TFM-matching PsBash.Cmdlets.dll as a manifest resource named
    "PsBash.Module/cmdlets/{tfm}/PsBash.Cmdlets.dll". Core multi-targets
    net8.0;net10.0 and so does PsBash.Cmdlets; the ProjectReference above
    builds the matching TFM, so each Core TFM build embeds exactly one
    cmdlets variant. ModuleExtractor resolves the embedded resource by the
    running framework moniker at runtime.

    Runs BeforeTargets="PrepareResourceNames" so the EmbeddedResource item is
    registered before the SDK splits and names the resource list (adding it
    later, e.g. before CoreCompile, is too late — the resource never makes it
    into the assembly). DependsOnTargets ResolveProjectReferences guarantees
    the cmdlets ProjectReference has been built and its DLL exists on disk.
  -->
  <Target Name="EmbedCmdletsDll"
          BeforeTargets="PrepareResourceNames"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(_PsBashCmdletsEmbedded)' != 'true'">
    <!-- Idempotency guard: PrepareResourceNames can run more than once in a build,
         and a second pass would re-add these EmbeddedResource items, yielding
         "Resource identifier ... already used" from CSC. Add them exactly once. -->
    <PropertyGroup>
      <_PsBashCmdletsEmbedded>true</_PsBashCmdletsEmbedded>
      <_PsBashCmdletsDll>$(MSBuildThisFileDirectory)..\PsBash.Cmdlets\bin\$(Configuration)\$(TargetFramework)\PsBash.Cmdlets.dll</_PsBashCmdletsDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PsBashCmdletsDll)')"
           Text="PsBash.Cmdlets.dll not found at $(_PsBashCmdletsDll). The Core-&gt;Cmdlets ProjectReference should have built it for TFM $(TargetFramework). Check PsBash.Cmdlets.csproj TargetFrameworks." />
    <PropertyGroup>
      <_PsBashCmdletsBin>$(MSBuildThisFileDirectory)..\PsBash.Cmdlets\bin\$(Configuration)\$(TargetFramework)</_PsBashCmdletsBin>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(_PsBashCmdletsDll)"
                        LogicalName="PsBash.Module/cmdlets/$(TargetFramework)/PsBash.Cmdlets.dll"
                        Type="Non-Resx"
                        WithCulture="false" />
    </ItemGroup>
    <!-- Format-Styled (Strata) runtime deps. These exist in the cmdlets bin only
         when the cmdlets were built with UseStrata=true (the local feed is
         present); CI builds match nothing here and embed only the DLL above.
         Embedding them next to PsBash.Cmdlets.dll lets ModuleExtractor lay them
         down together so the cmdlet's LoadFrom context resolves them at runtime
         (without this, Format-Styled fails: "Could not load Strata.Abstractions").
         Parlot / PsBash.Transpiler are already loaded by the host process, so they
         are intentionally not re-embedded. A dedicated _StrataDep item with
         qualified %(_StrataDep.Filename) metadata keeps the per-file LogicalName
         batching from cross-contaminating the cmdlets-DLL item above. -->
    <ItemGroup>
      <_StrataDep Include="$(_PsBashCmdletsBin)\Strata.*.dll" />
      <_StrataDep Include="$(_PsBashCmdletsBin)\Spectre.Console.dll" />
      <!-- Yoga.Net is a pure-managed Yoga port (lib/, no runtimes/native) pulled in by
           Strata.Layout.Yoga for the grid layout pass. It does not match Strata.*, so
           embed it explicitly or Format-Styled's grid path fails to load at runtime. -->
      <_StrataDep Include="$(_PsBashCmdletsBin)\Yoga.Net.dll" />
      <EmbeddedResource Include="@(_StrataDep)"
                        LogicalName="PsBash.Module/cmdlets/$(TargetFramework)/%(_StrataDep.Filename)%(_StrataDep.Extension)"
                        Type="Non-Resx"
                        WithCulture="false" />
    </ItemGroup>
  </Target>

</Project>
