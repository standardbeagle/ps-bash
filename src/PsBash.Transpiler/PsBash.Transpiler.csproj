<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Leaf project owning the bash parser + transpiler surface. Both PsBash.Core
    and PsBash.Cmdlets depend on this project; it depends on nothing in the
    repo. Splitting it out of PsBash.Core breaks the Core<->Cmdlets reference
    cycle so PsBash.Core can take a ProjectReference to PsBash.Cmdlets.
    Namespaces stay PsBash.Core.Parser / PsBash.Core.Transpiler (assembly name
    is independent of namespace) to keep this a zero-churn move for consumers.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet package metadata. PsBash.Core takes a ProjectReference to this
         project, so Core's nupkg declares a dependency on PsBash.Transpiler at
         this Version. It MUST be published to nuget.org alongside PsBash.Core or
         consumers hit NU1101. The publish workflow patches <Version> from the
         release tag (kept in lockstep with PsBash.Core / the module). -->
    <PackageId>PsBash.Transpiler</PackageId>
    <Version>0.10.10</Version>
    <Authors>StandardBeagle</Authors>
    <Description>Bash parser and AST (based on Oils/OSH) plus the PowerShell emitter that powers PsBash.Core. Leaf library with no PsBash dependencies.</Description>
    <PackageTags>bash;powershell;transpiler;parser;ast;shell</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/standardbeagle/ps-bash</PackageProjectUrl>
    <RepositoryUrl>https://github.com/standardbeagle/ps-bash</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Parlot" Version="1.5.7" />
  </ItemGroup>

</Project>
