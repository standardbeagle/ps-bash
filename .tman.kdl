// tman supervision for ps-bash builds and test runs.
//
// Why this exists: bare `dotnet build` / `dotnet test` leak MSBuild worker nodes
// and testhost processes, and CONCURRENT builds against the shared
// src/*/bin/Debug/net10.0 outputs are the documented root cause of this repo's
// suite flakiness (a half-written test bin can't start a runspace, so spawned
// hosts fail with "stream closed before EXIT sentinel" or 30s zero-output hangs).
// tman gives us the kill-tree + the mutual exclusion in one place.

defaults {
    // max-parallel 1 is the load-bearing setting: ONE build-or-test at a time in
    // this directory. Raising it re-opens the concurrent-build corruption above.
    //
    // Cross-alias serialization: tman buckets by alias NAME, so build/test/test-proj/pester
    // would each get their own slot. All four therefore run scripts/tman-job.ps1, which takes
    // ONE per-checkout file lock - they queue behind each other whatever the alias.
    // (Output while queued keeps `stall` from killing a waiting job.)
    max-parallel 1

    // Machine-wide gate: tman-job.ps1 re-runs itself as a NESTED `tman run --max-parallel 2`
    // from one shared directory, so main + every agent worktree share ONE build/test slot
    // (PSBASH_TMAN_MACHINE_SLOTS, default 1): no build overlaps a test anywhere on the machine. The REAL limits live on that inner run: stall 5m (a run
    // with no output and no cpu/io for this long is wedged — classically a spawned ps-bash host
    // waiting on a runspace that never came up) and max-time 45m. These OUTER limits only have
    // to outlast a silent wait in the machine queue (queue-timeout 60m) plus the run itself.
    stall "70m"
    max-time "2h"

    // NOT used: max-mem. In tman 0.5.1 it measures only the direct child (pwsh), not the
    // dotnet/testhost processes below it — a 900MB grandchild survived a 400MB cap (tested
    // 2026-10-01) — so it would look like protection without being any.

    retain "24h"
}

// All verbs run scripts/tman-job.ps1 (see its header). Three reasons, all measured:
//  1. test/test-proj BUILD FIRST in the same job, then `dotnet test --no-build` - the old
//     test-proj was --no-build alone and silently tested stale DLLs after an edit.
//  2. tman 0.5.1 rewrites `-m:1` -> `-m: 1` and `-nodeReuse:false` -> `-nodeReuse: false`
//     (space inserted after the colon) in args it passes through, breaking MSBuild
//     switches. The switches live in the script; only user args cross tman.
//  3. -m:1 -nodeReuse:false -p:UseSharedCompilation=false are load-bearing (serial test
//     projects; an aborted build leaves no MSBuild node / VBCSCompiler holding obj/bin;
//     see git 94ab500, b32b2b2, docs/bugs/drain-build-leaves-locked-obj.md).
// Alias args are appended, so:
//   tman build | tman test | tman test-proj <proj> --filter "A|B" | tman pester -Filter '*x*'
alias "build" {
    command "pwsh"
    args "-NoProfile" "-File" "scripts/tman-job.ps1" "build"
}

alias "test" {
    command "pwsh"
    args "-NoProfile" "-File" "scripts/tman-job.ps1" "test"
}

alias "test-proj" {
    command "pwsh"
    args "-NoProfile" "-File" "scripts/tman-job.ps1" "test-proj"
}

// Ad-hoc probe of this checkout's dev build: `tman dev -c 'snippet'` / `tman dev script.sh`.
// Never run src/*/bin ps-bash directly — see the 'dev' verb in scripts/tman-job.ps1.
alias "dev" {
    command "pwsh"
    args "-NoProfile" "-File" "scripts/tman-job.ps1" "dev"
}

// Release-blocking Pester gate (scripts/pester.ps1: builds cmdlets, refreshes beside-module DLLs).
alias "pester" {
    command "pwsh"
    args "-NoProfile" "-File" "scripts/tman-job.ps1" "pester"
}