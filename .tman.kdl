// tman supervision for ps-bash builds and test runs.
//
// Why this exists: bare `dotnet build` / `dotnet test` leak MSBuild worker nodes
// and testhost processes, and CONCURRENT builds against the shared
// src/*/bin/Debug/net10.0 outputs are the documented root cause of this repo's
// suite flakiness (a half-written test bin can't start a runspace, so spawned
// hosts fail with "stream closed before EXIT sentinel" or 30s zero-output hangs).
// tman gives us the kill-tree + the mutual exclusion in one place.

defaults {
    // max-parallel 1 is the load-bearing setting: ONE build-or-test at a time in
    // this directory. Raising it re-opens the concurrent-build corruption above.
    //
    // SCOPE OF THIS GUARANTEE - know the gap before you rely on it. tman buckets by
    // NAME-OR-COMMAND @ dir, and an alias's bucket is its OWN NAME. So:
    //   `tman test` twice      -> second queues/refuses. PROTECTED.
    //   `tman test` + `tman test-proj` -> DIFFERENT buckets, they RUN CONCURRENTLY.
    // Measured, not theoretical: a coordinator full-suite run and a subagent's
    // project run overlapped for 16 minutes and contaminated the result.
    //
    // A `name` node inside an alias block does NOT fix this - tman only honors
    // --name on `tman run`, and `tman ls` shows such runs still named after the
    // alias. That was tried and reverted rather than left in as a guarantee that
    // does not hold.
    //
    // So the cross-alias case is DISCIPLINE, not enforcement: never start a suite
    // while an implementer subagent is active, and check `tman ls` if unsure.
    // To enforce it for a one-off, use the flag form directly:
    //   tman run --name psbash-buildtest --max-parallel 1 -- dotnet test ...
    max-parallel 1

    // Suites here are minutes, not tens of minutes. A run with no output and no
    // cpu/io for this long is wedged (the classic symptom is a spawned ps-bash
    // host waiting forever on a runspace that never came up).
    stall "5m"

    // Hard ceiling. The full suite is well under this; anything longer is a hang.
    max-time "45m"

    retain "24h"
}

// Full solution build. Everything else assumes this ran.
alias "build" {
    command "dotnet"
    args "build" "-c" "Debug" "-f" "net10.0" "--nologo"
}

// Full suite across every test project.
// Prefer `tman test-proj src/PsBash.Core.Tests` when a slice's blast radius is
// genuinely local; use this before closing anything that touches production code.
//
// -m:1 is load-bearing, not tidiness. At solution level `dotnet test` runs test
// PROJECTS in parallel, and the spawn-heavy suites (Shell PTY, Differential,
// Escalation) all launch real ps-bash hosts. Running them concurrently produces
// exactly the contention this repo's flakiness is documented to come from: a
// first full run under default parallelism failed 38 tests, every sampled one of
// which passed in isolation. Serializing projects is the whole point of
// max-parallel 1 above; without -m:1 that guarantee stops at the process
// boundary and is violated *inside* a single invocation.
alias "test" {
    command "dotnet"
    args "test" "-f" "net10.0" "--no-build" "--nologo" "-m:1"
}

// One project: `tman test-proj src/PsBash.Cmdlets.Tests`
// Append xunit filters after the path, e.g. --filter "FullyQualifiedName~Fused"
// (quote any filter containing | — an unquoted pipe becomes a shell pipe and hangs).
alias "test-proj" {
    command "dotnet"
    args "test" "-f" "net10.0" "--no-build" "--nologo"
}
